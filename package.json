{
  "name": "gateos-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gateos/web",
    "build": "tsc -b && npm run build -w @gateos/web",
    "build:web": "npm run build -w @gateos/web",
    "typecheck": "tsc -b --pretty false",
    "test": "tsc -b && vitest run",
    "test:watch": "vitest",
    "ci": "npm test && npm run build:web"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
