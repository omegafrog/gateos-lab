{
  "schema": "gateos.challenge/v1",
  "id": "logic.and4",
  "title": "4-bit Bitwise AND",
  "description": "4-bit A와 B의 각 bit에 AND를 독립적으로 적용하는 bitwise AND 회로를 만드세요.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 4
      },
      {
        "id": "b",
        "name": "B",
        "width": 4
      }
    ],
    "outputs": [
      {
        "id": "out",
        "name": "OUT",
        "width": 4
      }
    ]
  },
  "allowedComponents": [
    "builtin.split4",
    "builtin.join4",
    "user.and"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 15
          },
          "out": {
            "out": 0
          }
        },
        {
          "in": {
            "a": 15,
            "b": 15
          },
          "out": {
            "out": 15
          }
        },
        {
          "in": {
            "a": 10,
            "b": 12
          },
          "out": {
            "out": 8
          }
        },
        {
          "in": {
            "a": 5,
            "b": 3
          },
          "out": {
            "out": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 9,
            "b": 6
          },
          "out": {
            "out": 0
          }
        },
        {
          "in": {
            "a": 14,
            "b": 7
          },
          "out": {
            "out": 6
          }
        }
      ]
    },
    {
      "type": "structural",
      "visibility": "visible",
      "rules": {
        "maxComponents": 7
      }
    }
  ],
  "unlocks": [
    "logic.or4"
  ],
  "hints": [
    {
      "level": 1,
      "title": "각 bit는 서로 독립적입니다",
      "body": "4-bit AND는 새로운 논리가 아니라 1-bit AND 네 개를 병렬로 놓은 것입니다."
    },
    {
      "level": 2,
      "title": "Split4와 Join4 사용",
      "body": "A와 B를 각각 Split4로 나누고 같은 번호 bit끼리 AND한 뒤 네 결과를 Join4로 다시 묶으세요."
    },
    {
      "level": 3,
      "title": "연결 방향",
      "body": "A.B0 AND B.B0→OUT.B0, ... A.B3 AND B.B3→OUT.B3 순서로 네 AND를 구성하세요."
    }
  ]
}
