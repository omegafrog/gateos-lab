{
  "schema": "gateos.challenge/v1",
  "id": "cpu.register-transfer4",
  "title": "Register-to-Register Transfer",
  "description": "Register File을 이용해 R[DST]←R[SRC] 같은 register-to-register transfer와 외부 DATA load를 하나의 write-back path로 구성하세요. 데이터의 출발점, write source 선택, destination commit을 분리해 봅니다.",
  "interface": {
    "inputs": [
      {
        "id": "data",
        "name": "DATA",
        "width": 4
      },
      {
        "id": "src",
        "name": "SRC",
        "width": 2
      },
      {
        "id": "dst",
        "name": "DST",
        "width": 2
      },
      {
        "id": "load",
        "name": "LOAD",
        "width": 1
      },
      {
        "id": "move",
        "name": "MOVE",
        "width": 1
      },
      {
        "id": "clk",
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "src_q",
        "name": "SRC_Q",
        "width": 4
      },
      {
        "id": "dst_q",
        "name": "DST_Q",
        "width": 4
      }
    ]
  },
  "allowedComponents": [
    "user.register-file4",
    "user.mux4",
    "user.or"
  ],
  "validators": [
    {
      "type": "sequence",
      "visibility": "visible",
      "steps": [
        {
          "set": {
            "data": 6,
            "src": 0,
            "dst": 1,
            "load": 1,
            "move": 0,
            "clk": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "data": 3,
            "dst": 2
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "load": 0,
            "src": 1,
            "dst": 2
          }
        },
        {
          "expect": {
            "src_q": 6,
            "dst_q": 3
          }
        },
        {
          "set": {
            "move": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "src_q": 6,
            "dst_q": 6
          }
        },
        {
          "set": {
            "clk": 0,
            "move": 0
          }
        }
      ]
    },
    {
      "type": "sequence",
      "visibility": "hidden",
      "steps": [
        {
          "set": {
            "data": 9,
            "src": 0,
            "dst": 3,
            "load": 1,
            "move": 0,
            "clk": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "data": 4,
            "dst": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "load": 0,
            "src": 3,
            "dst": 0,
            "move": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "src_q": 9,
            "dst_q": 9
          }
        }
