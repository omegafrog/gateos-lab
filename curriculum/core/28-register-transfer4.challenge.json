  "unlocks": [
    "cpu.alu-datapath4"
  ],
  "referenceTables": [
    {
      "id": "transfer-control",
      "title": "Register Transfer 제어",
      "description": "LOAD와 MOVE는 ‘무슨 값을 쓸지’와 ‘쓸 것인지’를 함께 결정합니다. source read는 combinational이고 destination state change는 rising edge에서만 발생합니다.",
      "timing": "SRC_Q/DST_Q는 현재 state의 read 결과입니다. write-back data가 안정된 뒤 rising edge에서 DST register가 갱신됩니다.",
      "columns": [
        {
          "id": "load",
          "label": "LOAD",
          "group": "input"
        },
        {
          "id": "move",
          "label": "MOVE",
          "group": "input"
        },
        {
          "id": "writeData",
          "label": "write data",
          "group": "state"
        },
        {
          "id": "we",
          "label": "WE",
          "group": "output"
        },
        {
          "id": "meaning",
          "label": "동작",
          "group": "note"
        }
      ],
      "rows": [
        {
          "load": "0",
          "move": "0",
          "writeData": "—",
          "we": "0",
          "meaning": "Hold"
        },
        {
          "load": "1",
          "move": "0",
          "writeData": "DATA",
          "we": "1",
          "meaning": "외부 값 load"
        },
        {
          "load": "—",
          "move": "1",
          "writeData": "SRC_Q",
          "we": "1",
          "meaning": "SRC → DST"
        }
      ]
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "읽기와 쓰기는 다른 사건입니다",
      "body": "SRC가 source register 값을 wire에 나타나게 하는 것만으로 DST state가 바뀌지 않습니다. 실제 transfer는 write data와 destination, enable이 준비된 rising edge에서 일어납니다."
    },
    {
      "level": 2,
      "title": "write source와 write enable을 따로 만드세요",
      "body": "MUX는 DATA와 source read value 중 어떤 값을 Register File.D에 보낼지 선택하고, LOAD/MOVE control은 실제 write 여부를 결정합니다."
    },
    {
      "level": 3,
      "title": "control contract를 따라 연결하세요",
      "body": "SRC는 read address, DST는 WADDR에 대응합니다. 선택된 write data를 D로 보내고 LOAD 또는 MOVE가 요청된 경우에만 WE가 활성되도록 하세요."
    }
  ]
}
