{
  "schema": "gateos.challenge/v1",
  "id": "logic.or",
  "title": "OR",
  "description": "앞에서 만든 NOT과 AND만으로 OR을 만드세요. De Morgan 법칙 ¬(¬A·¬B)=A+B를 회로로 구현하면서 Boolean algebra가 배선 변환 규칙으로 쓰인다는 점을 확인합니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 1
      },
      {
        "id": "b",
        "name": "B",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "out",
        "name": "OUT",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "user.not",
    "user.and"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 0
          },
          "out": {
            "out": 0
          }
        },
        {
          "in": {
            "a": 1,
            "b": 0
          },
          "out": {
            "out": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 1
          },
          "out": {
            "out": 1
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1
          },
          "out": {
            "out": 1
          }
        }
      ]
    }
  ],
  "unlocks": [
    "logic.xor"
  ],
  "hints": [
    {
      "level": 1,
      "title": "OR의 0인 경우부터 보세요",
      "body": "OR은 A=B=0일 때만 0입니다. 입력을 반전하면 이 유일한 0 조건을 AND가 검출할 수 있습니다."
    },
    {
      "level": 2,
      "title": "De Morgan 구조",
      "body": "A와 B를 각각 NOT한 뒤 AND하고, 그 결과를 다시 NOT하면 OR이 됩니다."
    },
    {
      "level": 3,
      "title": "배선 확인",
      "body": "A→NOT_A, B→NOT_B, 두 NOT 출력→AND, AND.OUT→마지막 NOT, 마지막 NOT.OUT→OUT으로 연결하세요."
    }
  ]
}
