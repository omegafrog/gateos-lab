{
  "schema": "gateos.challenge/v1",
  "id": "state.register4",
  "title": "4-bit Enable Register",
  "description": "네 개의 1-bit Enable Register를 같은 LOAD와 CLK로 묶어 하나의 4-bit word를 저장하는 Register를 만드세요. 여러 bit의 state가 한 control policy와 한 clock edge 아래 함께 움직인다는 점이 핵심입니다.",
  "interface": {
    "inputs": [
      {
        "id": "d",
        "name": "D",
        "width": 4
      },
      {
        "id": "load",
        "name": "LOAD",
        "width": 1
      },
      {
        "id": "clk",
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 4
      }
    ]
  },
  "allowedComponents": [
    "builtin.split4",
    "builtin.join4",
    "user.enable-register"
  ],
  "validators": [
    {
      "type": "sequence",
      "visibility": "visible",
      "steps": [
        {
          "set": {
            "d": 10,
            "load": 1,
            "clk": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 10
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "d": 5,
            "load": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 10
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "load": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 5
          }
        }
      ]
    },
    {
      "type": "sequence",
      "visibility": "hidden",
      "steps": [
        {
          "set": {
            "d": 15,
            "load": 1,
            "clk": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 15
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "d": 0,
            "load": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 15
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "load": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        }
      ]
    },
    {
      "type": "structural",
      "visibility": "visible",
      "rules": {
        "maxComponents": 6
      }
    }
  ],
  "unlocks": [
    "state.counter4"
  ],
  "referenceTables": [
    {
      "id": "characteristic",
      "title": "4-bit Enable Register 상태표",
      "description": "4-bit Register는 네 bit가 따로 저장되지만 외부에서는 하나의 word state처럼 동작합니다. LOAD와 CLK가 공통이므로 부분 update 없이 전체 word가 함께 유지되거나 갱신됩니다.",
      "timing": "D와 LOAD가 next word를 결정하고, rising edge에서 네 bit가 동시에 Q로 commit됩니다.",
      "columns": [
        {
          "id": "load",
          "label": "LOAD",
          "group": "input"
        },
        {
          "id": "d",
          "label": "D[3:0]",
          "group": "input"
        },
        {
          "id": "qt",
          "label": "Q(edge 전)",
          "group": "state"
        },
        {
          "id": "qnext",
          "label": "Q(edge 후)",
          "group": "output"
        },
        {
          "id": "meaning",
          "label": "의미",
          "group": "note"
        }
      ],
      "rows": [
        {
          "load": "0",
          "d": "—",
          "qt": "현재 값",
          "qnext": "현재 값",
          "meaning": "Hold (유지)"
        },
        {
          "load": "1",
          "d": "abcd",
          "qt": "—",
          "qnext": "abcd",
          "meaning": "4-bit D 저장"
        }
      ],
      "notes": [
        "Split4의 B0가 LSB, B3가 MSB입니다.",
        "모든 1-bit Register가 같은 LOAD와 CLK를 공유해야 네 bit가 동시에 갱신됩니다."
      ]
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "word는 여러 storage cell의 묶음입니다",
      "body": "D[3:0]의 각 bit는 별도 1-bit Register에 저장되지만 LOAD와 CLK는 네 cell이 모두 공유해야 합니다."
    },
    {
      "level": 2,
      "title": "Split4와 Join4로 bit significance를 보존",
      "body": "D를 B0~B3로 나눠 같은 번호의 register에 넣고, 각 Q를 같은 번호로 Join4에 다시 묶으세요."
    },
    {
      "level": 3,
      "title": "동시 update를 확인하세요",
      "body": "네 Enable Register의 LOAD와 CLK를 공통 연결하세요. LOAD=1인 rising edge에서 word 전체가 함께 바뀌고 LOAD=0이면 네 bit 모두 유지되어야 합니다."
    }
  ]
}
