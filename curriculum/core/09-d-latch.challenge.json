{
  "schema": "gateos.challenge/v1",
  "id": "state.d-latch",
  "title": "D Latch",
  "description": "SR Latch를 감싸 D 하나와 ENABLE 하나로 제어되는 D Latch를 만드세요. ENABLE=1일 때는 Q가 D를 따라가고, ENABLE=0일 때는 마지막 값을 유지하는 level-sensitive storage입니다.",
  "interface": {
    "inputs": [
      {
        "id": "d",
        "name": "D",
        "width": 1
      },
      {
        "id": "enable",
        "name": "ENABLE",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "builtin.nand",
    "user.not",
    "user.sr-latch"
  ],
  "validators": [
    {
      "type": "sequence",
      "visibility": "visible",
      "steps": [
        {
          "set": {
            "d": 0,
            "enable": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        },
        {
          "set": {
            "enable": 0,
            "d": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        },
        {
          "set": {
            "enable": 1
          }
        },
        {
          "expect": {
            "q": 1
          }
        },
        {
          "set": {
            "enable": 0,
            "d": 0
          }
        },
        {
          "expect": {
            "q": 1
          }
        },
        {
          "set": {
            "enable": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        }
      ]
    }
  ],
  "unlocks": [
    "state.dff"
  ],
  "referenceTables": [
    {
      "id": "characteristic",
      "title": "D Latch 상태표",
      "description": "D Latch는 level-sensitive입니다. ENABLE=1인 동안에는 Q(next)=D이고, ENABLE=0에서는 이전 Q를 유지합니다.",
      "columns": [
        {
          "id": "enable",
          "label": "ENABLE",
          "group": "input"
        },
        {
          "id": "d",
          "label": "D",
          "group": "input"
        },
        {
          "id": "qt",
          "label": "Q(적용 전)",
          "group": "state"
        },
        {
          "id": "qnext",
          "label": "Q(settle 후)",
          "group": "output"
        },
        {
          "id": "meaning",
          "label": "의미",
          "group": "note"
        }
      ],
      "rows": [
        {
          "enable": "0",
          "d": "X",
          "qt": "0",
          "qnext": "0",
          "meaning": "Hold (유지)"
        },
        {
          "enable": "0",
          "d": "X",
          "qt": "1",
          "qnext": "1",
          "meaning": "Hold (유지)"
        },
        {
          "enable": "1",
          "d": "0",
          "qt": "X",
          "qnext": "0",
          "meaning": "D를 따라감 (transparent)"
        },
        {
          "enable": "1",
          "d": "1",
          "qt": "X",
          "qnext": "1",
          "meaning": "D를 따라감 (transparent)"
        }
      ],
      "notes": [
        "ENABLE=1이면 latch가 열려 있어 Q가 D를 따라갑니다.",
        "ENABLE=0이면 feedback 경로가 이전 Q를 유지합니다.",
        "X는 해당 값이 결과 상태에 영향을 주지 않는다는 뜻입니다."
      ],
      "timing": "ENABLE=1인 전체 구간이 transparent window입니다. edge 한 번만 샘플하는 DFF와 구분하세요."
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "D와 ¬D가 set/reset 요청을 만듭니다",
      "body": "D=1이면 set 쪽, D=0이면 reset 쪽 요청이 필요합니다. 단, ENABLE=0일 때는 어느 쪽도 새 state를 강제하면 안 됩니다."
    },
    {
      "level": 2,
      "title": "ENABLE로 두 요청을 gate하세요",
      "body": "D와 ¬D를 ENABLE과 결합해 SR latch의 active-low 입력을 만들면, ENABLE=1일 때만 D가 state를 결정합니다."
    },
    {
      "level": 3,
      "title": "투명 구간을 확인하세요",
      "body": "ENABLE=1인 동안 D를 바꾸면 Q도 따라 바뀌어야 하고, ENABLE=0으로 내린 뒤 D를 바꿔도 Q는 유지되어야 합니다."
    }
  ]
}
