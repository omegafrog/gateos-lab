{
  "schema": "gateos.challenge/v1",
  "id": "state.d-latch",
  "title": "D Latch",
  "description": "이전에 만든 SR Latch를 이용해 D와 ENABLE을 받는 level-sensitive D Latch를 만드세요. ENABLE=1일 때 Q가 D를 따라가고, ENABLE=0일 때 마지막 값을 유지해야 합니다.",
  "interface": {
    "inputs": [
      {
        "id": "d",
        "name": "D",
        "width": 1
      },
      {
        "id": "enable",
        "name": "ENABLE",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "builtin.nand",
    "user.not",
    "user.sr-latch"
  ],
  "validators": [
    {
      "type": "sequence",
      "visibility": "visible",
      "steps": [
        {
          "set": {
            "d": 0,
            "enable": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        },
        {
          "set": {
            "enable": 0,
            "d": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        },
        {
          "set": {
            "enable": 1
          }
        },
        {
          "expect": {
            "q": 1
          }
        },
        {
          "set": {
            "enable": 0,
            "d": 0
          }
        },
        {
          "expect": {
            "q": 1
          }
        },
        {
          "set": {
            "enable": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        }
      ]
    }
  ],
  "unlocks": [
    "state.dff"
  ],
  "referenceTables": [
    {
      "id": "characteristic",
      "title": "D Latch 상태표",
      "description": "ENABLE이 열려 있을 때 D를 따라가고, 닫히면 feedback으로 마지막 Q를 유지합니다.",
      "columns": [
        {
          "id": "enable",
          "label": "ENABLE",
          "group": "input"
        },
        {
          "id": "d",
          "label": "D",
          "group": "input"
        },
        {
          "id": "qt",
          "label": "Q(적용 전)",
          "group": "state"
        },
        {
          "id": "qnext",
          "label": "Q(settle 후)",
          "group": "output"
        },
        {
          "id": "meaning",
          "label": "의미",
          "group": "note"
        }
      ],
      "rows": [
        {
          "enable": "0",
          "d": "X",
          "qt": "0",
          "qnext": "0",
          "meaning": "Hold (유지)"
        },
        {
          "enable": "0",
          "d": "X",
          "qt": "1",
          "qnext": "1",
          "meaning": "Hold (유지)"
        },
        {
          "enable": "1",
          "d": "0",
          "qt": "X",
          "qnext": "0",
          "meaning": "D를 따라감 (transparent)"
        },
        {
          "enable": "1",
          "d": "1",
          "qt": "X",
          "qnext": "1",
          "meaning": "D를 따라감 (transparent)"
        }
      ],
      "notes": [
        "ENABLE=1이면 latch가 열려 있어 Q가 D를 따라갑니다.",
        "ENABLE=0이면 feedback 경로가 이전 Q를 유지합니다.",
        "X는 해당 값이 결과 상태에 영향을 주지 않는다는 뜻입니다."
      ],
      "timing": "레벨 민감(level-sensitive) — Clock edge가 아니라 ENABLE의 레벨로 동작합니다."
    }
  ]
}
