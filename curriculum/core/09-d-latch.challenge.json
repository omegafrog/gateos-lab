{
  "schema": "gateos.challenge/v1",
  "id": "state.d-latch",
  "title": "D Latch",
  "description": "이전에 만든 SR Latch를 이용해 D와 ENABLE을 받는 level-sensitive D Latch를 만드세요. ENABLE=1일 때 Q가 D를 따라가고, ENABLE=0일 때 마지막 값을 유지해야 합니다.",
  "interface": {
    "inputs": [
      {
        "id": "d",
        "name": "D",
        "width": 1
      },
      {
        "id": "enable",
        "name": "ENABLE",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "builtin.nand",
    "user.not",
    "user.sr-latch"
  ],
  "validators": [
    {
      "type": "sequence",
      "visibility": "visible",
      "steps": [
        {
          "set": {
            "d": 0,
            "enable": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        },
        {
          "set": {
            "enable": 0,
            "d": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        },
        {
          "set": {
            "enable": 1
          }
        },
        {
          "expect": {
            "q": 1
          }
        },
        {
          "set": {
            "enable": 0,
            "d": 0
          }
        },
        {
          "expect": {
            "q": 1
          }
        },
        {
          "set": {
            "enable": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        }
      ]
    }
  ],
  "unlocks": [
    "state.dff"
  ],
  "referenceTables": [
    {
      "id": "characteristic",
      "title": "D Latch 상태표",
      "description": "ENABLE이 열려 있을 때 D를 따라가고, 닫히면 feedback으로 마지막 Q를 유지합니다.",
      "columns": [
        {
          "id": "enable",
          "label": "ENABLE",
          "group": "input"
        },
        {
          "id": "d",
          "label": "D",
          "group": "input"
        },
        {
          "id": "qt",
          "label": "Q(적용 전)",
          "group": "state"
        },
        {
          "id": "qnext",
          "label": "Q(settle 후)",
          "group": "output"
        },
        {
          "id": "meaning",
          "label": "의미",
          "group": "note"
        }
      ],
      "rows": [
        {
          "enable": "0",
          "d": "X",
          "qt": "0",
          "qnext": "0",
          "meaning": "Hold (유지)"
        },
        {
          "enable": "0",
          "d": "X",
          "qt": "1",
          "qnext": "1",
          "meaning": "Hold (유지)"
        },
        {
          "enable": "1",
          "d": "0",
          "qt": "X",
          "qnext": "0",
          "meaning": "D를 따라감 (transparent)"
        },
        {
          "enable": "1",
          "d": "1",
          "qt": "X",
          "qnext": "1",
          "meaning": "D를 따라감 (transparent)"
        }
      ],
      "notes": [
        "ENABLE=1이면 latch가 열려 있어 Q가 D를 따라갑니다.",
        "ENABLE=0이면 feedback 경로가 이전 Q를 유지합니다.",
        "X는 해당 값이 결과 상태에 영향을 주지 않는다는 뜻입니다."
      ],
      "timing": "레벨 민감(level-sensitive) — Clock edge가 아니라 ENABLE의 레벨로 동작합니다."
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "D를 SR Latch 입력으로 바꾸기",
      "body": "D Latch는 D 하나를 그대로 저장하는 것이 아니라, ENABLE과 D를 이용해 SR Latch의 active-low S̅/R̅ 신호를 만들어 사용합니다."
    },
    {
      "level": 2,
      "title": "ENABLE이 1일 때만 Set/Reset 허용",
      "body": "ENABLE=1일 때 D=1이면 Set, D=0이면 Reset이 되게 해야 합니다. D와 NOT D를 각각 ENABLE과 NAND해보세요."
    },
    {
      "level": 3,
      "title": "연결 방향",
      "body": "S̅=NAND(D, ENABLE), R̅=NAND(NOT D, ENABLE)을 만들고 이 둘을 SR Latch의 S̅/R̅에 연결하세요. SR Latch의 Q가 최종 Q입니다."
    }
  ]
}
