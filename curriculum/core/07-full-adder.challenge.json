{
  "schema": "gateos.challenge/v1",
  "id": "arithmetic.full-adder",
  "title": "Full Adder",
  "description": "A, B와 이전 자리의 CIN을 더해 SUM과 다음 자리의 COUT을 만드는 Full Adder를 만드세요. multi-bit addition을 가능하게 하는 핵심은 carry-in/carry-out을 한 bit-slice 안에 포함하는 것입니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 1
      },
      {
        "id": "b",
        "name": "B",
        "width": 1
      },
      {
        "id": "cin",
        "name": "CIN",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "sum",
        "name": "SUM",
        "width": 1
      },
      {
        "id": "cout",
        "name": "COUT",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "user.half-adder",
    "user.or"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 0,
            "cin": 0
          },
          "out": {
            "sum": 0,
            "cout": 0
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1,
            "cin": 1
          },
          "out": {
            "sum": 1,
            "cout": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 0,
            "cin": 1
          },
          "out": {
            "sum": 1,
            "cout": 0
          }
        },
        {
          "in": {
            "a": 0,
            "b": 1,
            "cin": 0
          },
          "out": {
            "sum": 1,
            "cout": 0
          }
        },
        {
          "in": {
            "a": 0,
            "b": 1,
            "cin": 1
          },
          "out": {
            "sum": 0,
            "cout": 1
          }
        },
        {
          "in": {
            "a": 1,
            "b": 0,
            "cin": 0
          },
          "out": {
            "sum": 1,
            "cout": 0
          }
        },
        {
          "in": {
            "a": 1,
            "b": 0,
            "cin": 1
          },
          "out": {
            "sum": 0,
            "cout": 1
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1,
            "cin": 0
          },
          "out": {
            "sum": 0,
            "cout": 1
          }
        }
      ]
    }
  ],
  "unlocks": [
    "state.sr-latch"
  ],
  "hints": [
    {
      "level": 1,
      "title": "세 bit를 한 번에 생각하지 않아도 됩니다",
      "body": "A+B를 먼저 더하고, 그 중간 SUM에 CIN을 더하는 두 단계로 나눌 수 있습니다."
    },
    {
      "level": 2,
      "title": "Half Adder 두 개 + carry 결합",
      "body": "첫 Half Adder의 SUM을 두 번째 Half Adder 입력으로 보내고, 두 단계에서 나온 carry 후보는 OR로 합치세요."
    },
    {
      "level": 3,
      "title": "배선 확인",
      "body": "HA1(A,B)→S1,C1; HA2(S1,CIN)→SUM,C2; C1 OR C2→COUT으로 연결하세요."
    }
  ]
}
