{
  "schema": "gateos.challenge/v1",
  "id": "arithmetic.full-adder",
  "title": "Full Adder",
  "description": "A, B, CIN 세 bit를 더해 SUM과 COUT을 만드는 Full Adder를 구현하세요. 이전 자리의 carry를 받아 다음 자리로 전달할 수 있는 재사용 가능한 ‘한 자리 덧셈 블록’을 만드는 것이 목표입니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 1
      },
      {
        "id": "b",
        "name": "B",
        "width": 1
      },
      {
        "id": "cin",
        "name": "CIN",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "sum",
        "name": "SUM",
        "width": 1
      },
      {
        "id": "cout",
        "name": "COUT",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "user.half-adder",
    "user.or"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 0,
            "cin": 0
          },
          "out": {
            "sum": 0,
            "cout": 0
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1,
            "cin": 1
          },
          "out": {
            "sum": 1,
            "cout": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 0,
            "cin": 1
          },
          "out": {
            "sum": 1,
            "cout": 0
          }
        },
        {
          "in": {
            "a": 0,
            "b": 1,
            "cin": 0
          },
          "out": {
            "sum": 1,
            "cout": 0
          }
        },
        {
          "in": {
            "a": 0,
            "b": 1,
            "cin": 1
          },
          "out": {
            "sum": 0,
            "cout": 1
          }
        },
        {
          "in": {
            "a": 1,
            "b": 0,
            "cin": 0
          },
          "out": {
            "sum": 1,
            "cout": 0
          }
        },
        {
          "in": {
            "a": 1,
            "b": 0,
            "cin": 1
          },
          "out": {
            "sum": 0,
            "cout": 1
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1,
            "cin": 0
          },
          "out": {
            "sum": 0,
            "cout": 1
          }
        }
      ]
    }
  ],
  "unlocks": [
    "state.sr-latch"
  ],
  "hints": [
    {
      "level": 1,
      "title": "Half Adder 두 개로 나누기",
      "body": "먼저 A+B를 계산하고, 그 SUM에 CIN을 한 번 더 더한다고 생각해보세요."
    },
    {
      "level": 2,
      "title": "중간 SUM과 두 CARRY",
      "body": "첫 Half Adder가 A,B를 더하고, 두 번째 Half Adder가 첫 SUM과 CIN을 더합니다. 두 단계에서 생긴 CARRY는 OR로 합치면 됩니다."
    },
    {
      "level": 3,
      "title": "연결 방향",
      "body": "HA1(A,B)→S1,C1, HA2(S1,CIN)→SUM,C2로 만들고, C1과 C2를 OR에 넣어 COUT으로 연결하세요."
    }
  ]
}
