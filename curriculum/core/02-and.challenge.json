{
  "schema": "gateos.challenge/v1",
  "id": "logic.and",
  "title": "AND",
  "description": "NAND와 앞에서 만든 NOT을 조합해 AND를 만드세요. NAND가 AND 결과의 반전이라는 관계를 이용해, Boolean 식의 이중 부정을 실제 회로 구조로 바꿔봅니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 1
      },
      {
        "id": "b",
        "name": "B",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "out",
        "name": "OUT",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "builtin.nand",
    "user.not"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 0
          },
          "out": {
            "out": 0
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1
          },
          "out": {
            "out": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 1
          },
          "out": {
            "out": 0
          }
        },
        {
          "in": {
            "a": 1,
            "b": 0
          },
          "out": {
            "out": 0
          }
        }
      ]
    }
  ],
  "unlocks": [
    "logic.or"
  ],
  "hints": [
    {
      "level": 1,
      "title": "NAND는 거의 AND입니다",
      "body": "NAND의 출력은 ¬(A·B)입니다. 원하는 A·B와 무엇이 한 단계 다른지 보세요."
    },
    {
      "level": 2,
      "title": "반전을 한 번 더 제거",
      "body": "A와 B를 NAND에 넣고 그 출력을 NOT에 통과시키면 ¬¬(A·B)=A·B가 됩니다."
    },
    {
      "level": 3,
      "title": "배선 확인",
      "body": "A/B→NAND.A/B, NAND.OUT→NOT.IN, NOT.OUT→회로 OUT 순서로 연결하세요."
    }
  ]
}
