{
  "schema": "gateos.challenge/v1",
  "id": "arithmetic.half-adder",
  "title": "Half Adder",
  "description": "두 1-bit 수 A와 B를 더해 SUM과 CARRY를 출력하는 Half Adder를 만드세요. 1+1=10이므로 한 자리 덧셈도 두 종류의 출력 정보가 필요합니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 1
      },
      {
        "id": "b",
        "name": "B",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "sum",
        "name": "SUM",
        "width": 1
      },
      {
        "id": "carry",
        "name": "CARRY",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "user.xor",
    "user.and"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 0
          },
          "out": {
            "sum": 0,
            "carry": 0
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1
          },
          "out": {
            "sum": 0,
            "carry": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 1
          },
          "out": {
            "sum": 1,
            "carry": 0
          }
        },
        {
          "in": {
            "a": 1,
            "b": 0
          },
          "out": {
            "sum": 1,
            "carry": 0
          }
        }
      ]
    }
  ],
  "unlocks": [
    "arithmetic.full-adder"
  ],
  "hints": [
    {
      "level": 1,
      "title": "네 경우를 2-bit 결과로 써보세요",
      "body": "0+0=00, 0+1=01, 1+0=01, 1+1=10입니다. 낮은 bit와 높은 bit의 pattern을 따로 보세요."
    },
    {
      "level": 2,
      "title": "이미 만든 gate와 같은 pattern",
      "body": "SUM의 pattern은 XOR, CARRY의 pattern은 AND와 같습니다."
    },
    {
      "level": 3,
      "title": "배선 확인",
      "body": "A/B를 XOR과 AND에 동시에 fan-out하고 XOR.OUT→SUM, AND.OUT→CARRY로 연결하세요."
    }
  ]
}
