{
  "schema": "gateos.challenge/v1",
  "id": "arithmetic.half-adder",
  "title": "Half Adder",
  "description": "두 1-bit 수 A와 B를 더해 SUM과 CARRY를 출력하는 Half Adder를 만드세요. 1+1=10이므로 한 자리 덧셈도 두 종류의 출력 정보가 필요합니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 1
      },
      {
        "id": "b",
        "name": "B",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "sum",
        "name": "SUM",
        "width": 1
      },
      {
        "id": "carry",
        "name": "CARRY",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "user.xor",
    "user.and"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 0
          },
          "out": {
            "sum": 0,
            "carry": 0
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1
          },
          "out": {
            "sum": 0,
            "carry": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 1
          },
          "out": {
            "sum": 1,
            "carry": 0
          }
        },
        {
          "in": {
            "a": 1,
            "b": 0
          },
          "out": {
            "sum": 1,
            "carry": 0
          }
        }
      ]
    }
  ],
  "unlocks": [
    "arithmetic.full-adder"
  ],
  "hints": [
    {
      "level": 1,
      "title": "네 경우를 2-bit 결과로 써보세요",
      "body": "먼저 0+0=00, 0+1=01, 1+0=01, 1+1=10으로 적어 보세요. 각 결과의 낮은 bit가 SUM, 높은 bit가 CARRY라는 관점에서 두 출력의 패턴을 서로 분리해 관찰하세요."
    },
    {
      "level": 2,
      "title": "출력 패턴을 이미 만든 gate와 비교하세요",
      "body": "SUM은 두 입력이 서로 다를 때만 1이므로 XOR과 동일하고, CARRY는 두 입력이 모두 1일 때만 1이므로 AND와 동일합니다. 진리표의 각 열을 기존 gate의 진리표와 직접 대조해 보세요."
    },
    {
      "level": 3,
      "title": "두 gate가 같은 입력을 공유하도록 배선하세요",
      "body": "A와 B를 XOR과 AND 양쪽 입력으로 각각 fan-out한 뒤 XOR.OUT을 SUM에, AND.OUT을 CARRY에 연결하세요. 마지막으로 A=B=1에서 SUM=0, CARRY=1이 되는지 확인하면 배선 방향까지 검증할 수 있습니다."
    }
  ]
}
