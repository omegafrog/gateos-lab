{
  "schema": "gateos.challenge/v1",
  "id": "arithmetic.adder4",
  "title": "4-bit Ripple Carry Adder",
  "description": "Full Adder 네 개를 LSB→MSB carry chain으로 연결해 4-bit Ripple Carry Adder를 만드세요. multi-bit arithmetic에서 bit-slice가 독립적이지 않고 carry로 연결된다는 점이 핵심입니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 4
      },
      {
        "id": "b",
        "name": "B",
        "width": 4
      },
      {
        "id": "cin",
        "name": "CIN",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "sum",
        "name": "SUM",
        "width": 4
      },
      {
        "id": "cout",
        "name": "COUT",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "builtin.split4",
    "builtin.join4",
    "user.full-adder"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 0,
            "cin": 0
          },
          "out": {
            "sum": 0,
            "cout": 0
          }
        },
        {
          "in": {
            "a": 3,
            "b": 5,
            "cin": 0
          },
          "out": {
            "sum": 8,
            "cout": 0
          }
        },
        {
          "in": {
            "a": 7,
            "b": 8,
            "cin": 0
          },
          "out": {
            "sum": 15,
            "cout": 0
          }
        },
        {
          "in": {
            "a": 15,
            "b": 1,
            "cin": 0
          },
          "out": {
            "sum": 0,
            "cout": 1
          }
        },
        {
          "in": {
            "a": 15,
            "b": 15,
            "cin": 1
          },
          "out": {
            "sum": 15,
            "cout": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 6,
            "b": 9,
            "cin": 1
          },
          "out": {
            "sum": 0,
            "cout": 1
          }
        },
        {
          "in": {
            "a": 4,
            "b": 2,
            "cin": 1
          },
          "out": {
            "sum": 7,
            "cout": 0
          }
        }
      ]
    },
    {
      "type": "structural",
      "visibility": "visible",
      "rules": {
        "maxComponents": 7
      }
    }
  ],
  "unlocks": [
    "arithmetic.incrementer4"
  ],
  "hints": [
    {
      "level": 1,
      "title": "carry는 낮은 자리에서 높은 자리로",
      "body": "bit 0의 COUT이 bit 1의 CIN이 되고, 같은 방식으로 bit 3까지 이어져야 합니다."
    },
    {
      "level": 2,
      "title": "data는 병렬, carry는 직렬",
      "body": "A/B 각 bit는 자기 stage로 바로 들어가지만 carry만 stage 사이를 순서대로 통과합니다."
    },
    {
      "level": 3,
      "title": "연결 순서",
      "body": "FA0(A0,B0,CIN)→S0,C1; FA1(A1,B1,C1)→S1,C2; FA2→S2,C3; FA3→S3,COUT으로 연결하고 S0~S3를 Join4에 같은 순서로 묶으세요."
    }
  ]
}
