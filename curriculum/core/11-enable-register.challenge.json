{
  "schema": "gateos.challenge/v1",
  "id": "state.enable-register",
  "title": "1-bit Enable Register",
  "description": "D Flip-Flop과 MUX를 이용해 LOAD=1일 때만 새 D를 저장하고, LOAD=0이면 이전 Q를 다시 입력으로 되먹임해 유지하는 1-bit Register를 만드세요.",
  "interface": {
    "inputs": [
      {
        "id": "d",
        "name": "D",
        "width": 1
      },
      {
        "id": "load",
        "name": "LOAD",
        "width": 1
      },
      {
        "id": "clk",
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "user.mux2",
    "user.dff"
  ],
  "validators": [
    {
      "type": "sequence",
      "visibility": "visible",
      "steps": [
        {
          "set": {
            "d": 1,
            "load": 1,
            "clk": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "d": 0,
            "load": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "load": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        }
      ]
    }
  ],
  "unlocks": [],
  "referenceTables": [
    {
      "id": "characteristic",
      "title": "Enable Register state table",
      "description": "At each rising edge, LOAD chooses between preserving Q and capturing D.",
      "columns": [
        {
          "id": "load",
          "label": "LOAD",
          "group": "input"
        },
        {
          "id": "d",
          "label": "D",
          "group": "input"
        },
        {
          "id": "qt",
          "label": "Q(before edge)",
          "group": "state"
        },
        {
          "id": "qnext",
          "label": "Q(after edge)",
          "group": "output"
        },
        {
          "id": "meaning",
          "label": "Meaning",
          "group": "note"
        }
      ],
      "rows": [
        {
          "load": "0",
          "d": "X",
          "qt": "0",
          "qnext": "0",
          "meaning": "Hold"
        },
        {
          "load": "0",
          "d": "X",
          "qt": "1",
          "qnext": "1",
          "meaning": "Hold"
        },
        {
          "load": "1",
          "d": "0",
          "qt": "X",
          "qnext": "0",
          "meaning": "Load D"
        },
        {
          "load": "1",
          "d": "1",
          "qt": "X",
          "qnext": "1",
          "meaning": "Load D"
        }
      ],
      "notes": [
        "Rows describe behavior at the active rising clock edge."
      ],
      "timing": "Edge-triggered — LOAD is evaluated on the rising edge (↑)."
    }
  ]
}
