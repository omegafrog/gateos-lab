{
  "schema": "gateos.challenge/v1",
  "id": "arithmetic.alu4",
  "title": "4-bit ALU",
  "description": "A와 B에 대해 AND, OR, XOR, ADD 결과를 동시에 준비하고 OP가 지정한 하나를 OUT으로 선택하는 4-bit ALU를 만드세요. 핵심은 연산 자체보다 data path와 control을 분리해 여러 기능을 하나의 실행 블록으로 묶는 것입니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 4
      },
      {
        "id": "b",
        "name": "B",
        "width": 4
      },
      {
        "id": "op",
        "name": "OP",
        "width": 2
      }
    ],
    "outputs": [
      {
        "id": "out",
        "name": "OUT",
        "width": 4
      },
      {
        "id": "zero",
        "name": "ZERO",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "builtin.and4",
    "builtin.or4",
    "builtin.xor4",
    "user.adder4",
    "user.mux4",
    "user.zero4",
    "builtin.split2",
    "builtin.const1.zero"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 10,
            "b": 12,
            "op": 0
          },
          "out": {
            "out": 8,
            "zero": 0
          }
        },
        {
          "in": {
            "a": 10,
            "b": 12,
            "op": 1
          },
          "out": {
            "out": 14,
            "zero": 0
          }
        },
        {
          "in": {
            "a": 10,
            "b": 12,
            "op": 2
          },
          "out": {
            "out": 6,
            "zero": 0
          }
        },
        {
          "in": {
            "a": 3,
            "b": 5,
            "op": 3
          },
          "out": {
            "out": 8,
            "zero": 0
          }
        },
        {
          "in": {
            "a": 15,
            "b": 15,
            "op": 2
          },
          "out": {
            "out": 0,
            "zero": 1
          }
        },
        {
          "in": {
            "a": 0,
            "b": 0,
            "op": 3
          },
          "out": {
            "out": 0,
            "zero": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 7,
            "b": 1,
            "op": 3
          },
          "out": {
            "out": 8,
            "zero": 0
          }
        },
        {
          "in": {
            "a": 5,
            "b": 10,
            "op": 0
          },
          "out": {
            "out": 0,
            "zero": 1
          }
        },
        {
          "in": {
            "a": 9,
            "b": 6,
            "op": 1
          },
          "out": {
            "out": 15,
            "zero": 0
          }
        }
      ]
    },
    {
      "type": "structural",
      "visibility": "visible",
      "rules": {
        "maxComponents": 10
      }
    }
  ],
  "unlocks": [
    "memory.register-file4"
  ],
  "referenceTables": [
    {
      "id": "opcodes",
      "title": "ALU operation 선택표",
      "description": "OP는 ALU가 이미 계산한 후보 결과 중 하나를 고르는 control code입니다. ZERO는 선택된 최종 OUT이 0000인지 나타냅니다.",
      "columns": [
        {
          "id": "op",
          "label": "OP",
          "group": "input"
        },
        {
          "id": "operation",
          "label": "연산",
          "group": "note"
        },
        {
          "id": "result",
          "label": "OUT",
          "group": "output"
        }
      ],
      "rows": [
        {
          "op": "00",
          "operation": "AND",
          "result": "A AND B"
        },
        {
          "op": "01",
          "operation": "OR",
          "result": "A OR B"
        },
        {
          "op": "10",
          "operation": "XOR",
          "result": "A XOR B"
        },
        {
          "op": "11",
          "operation": "ADD",
          "result": "A + B (4-bit wrap)"
        }
      ],
      "notes": [
        "ZERO는 최종 선택된 OUT이 0000일 때 1입니다."
      ]
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "연산 블록은 후보를 만들고 OP는 고릅니다",
      "body": "AND4/OR4/XOR4/Adder4는 같은 A/B를 보고 각자 결과를 계산합니다. OP는 계산을 ‘만드는’ 신호가 아니라 어느 결과를 OUT에 연결할지 고르는 control입니다."
    },
    {
      "level": 2,
      "title": "2-bit OP는 두 단계 MUX로 해석할 수 있습니다",
      "body": "OP.B0로 AND↔OR와 XOR↔ADD를 각각 선택하고, OP.B1로 두 중간 결과 중 하나를 고르면 4개 후보를 선택할 수 있습니다."
    },
    {
      "level": 3,
      "title": "ZERO는 최종 OUT 뒤에서 계산하세요",
      "body": "세 MUX로 4개 후보를 선택한 최종 node를 회로 OUT과 Zero4.IN에 동시에 연결하세요. 후보 연산별 ZERO를 따로 만들면 OP와 status가 어긋날 수 있습니다."
    }
  ]
}
