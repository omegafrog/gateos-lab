{
  "schema": "gateos.challenge/v1",
  "id": "arithmetic.alu4",
  "title": "4-bit ALU",
  "description": "A, B, OP를 받아 AND, OR, XOR, ADD 중 하나를 선택하는 4-bit ALU를 만드세요. 4-bit AND/OR/XOR는 이미 제공되는 word-level 기본 부품이고, Adder4는 앞에서 만든 산술 부품입니다. OP=00 AND, 01 OR, 10 XOR, 11 ADD이며 ZERO는 최종 선택된 결과가 0000일 때 1이어야 합니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 4
      },
      {
        "id": "b",
        "name": "B",
        "width": 4
      },
      {
        "id": "op",
        "name": "OP",
        "width": 2
      }
    ],
    "outputs": [
      {
        "id": "out",
        "name": "OUT",
        "width": 4
      },
      {
        "id": "zero",
        "name": "ZERO",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "builtin.and4",
    "builtin.or4",
    "builtin.xor4",
    "user.adder4",
    "user.mux4",
    "user.zero4",
    "builtin.split2",
    "builtin.const1.zero"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 10,
            "b": 12,
            "op": 0
          },
          "out": {
            "out": 8,
            "zero": 0
          }
        },
        {
          "in": {
            "a": 10,
            "b": 12,
            "op": 1
          },
          "out": {
            "out": 14,
            "zero": 0
          }
        },
        {
          "in": {
            "a": 10,
            "b": 12,
            "op": 2
          },
          "out": {
            "out": 6,
            "zero": 0
          }
        },
        {
          "in": {
            "a": 3,
            "b": 5,
            "op": 3
          },
          "out": {
            "out": 8,
            "zero": 0
          }
        },
        {
          "in": {
            "a": 15,
            "b": 15,
            "op": 2
          },
          "out": {
            "out": 0,
            "zero": 1
          }
        },
        {
          "in": {
            "a": 0,
            "b": 0,
            "op": 3
          },
          "out": {
            "out": 0,
            "zero": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 7,
            "b": 1,
            "op": 3
          },
          "out": {
            "out": 8,
            "zero": 0
          }
        },
        {
          "in": {
            "a": 5,
            "b": 10,
            "op": 0
          },
          "out": {
            "out": 0,
            "zero": 1
          }
        },
        {
          "in": {
            "a": 9,
            "b": 6,
            "op": 1
          },
          "out": {
            "out": 15,
            "zero": 0
          }
        }
      ]
    },
    {
      "type": "structural",
      "visibility": "visible",
      "rules": {
        "maxComponents": 10
      }
    }
  ],
  "unlocks": [
    "memory.register-file4"
  ],
  "referenceTables": [
    {
      "id": "opcodes",
      "title": "ALU operation 선택표",
      "description": "OP 2-bit가 어떤 연산 결과를 OUT으로 보낼지 결정합니다.",
      "columns": [
        {
          "id": "op",
          "label": "OP",
          "group": "input"
        },
        {
          "id": "operation",
          "label": "연산",
          "group": "note"
        },
        {
          "id": "result",
          "label": "OUT",
          "group": "output"
        }
      ],
      "rows": [
        {
          "op": "00",
          "operation": "AND",
          "result": "A AND B"
        },
        {
          "op": "01",
          "operation": "OR",
          "result": "A OR B"
        },
        {
          "op": "10",
          "operation": "XOR",
          "result": "A XOR B"
        },
        {
          "op": "11",
          "operation": "ADD",
          "result": "A + B (4-bit wrap)"
        }
      ],
      "notes": [
        "ZERO는 최종 선택된 OUT이 0000일 때 1입니다."
      ]
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "네 연산 결과를 먼저 동시에 만드세요",
      "body": "AND4, OR4, XOR4는 제공 부품으로 사용하고 Adder4는 앞에서 만든 칩을 사용하세요. ALU에서 새로 배우는 핵심은 네 연산 결과 중 하나를 control signal인 OP로 선택하는 것입니다."
    },
    {
      "level": 2,
      "title": "OP 두 bit로 4개 후보 선택",
      "body": "OP.B0로 AND/OR와 XOR/ADD를 각각 1차 선택한 뒤, OP.B1로 두 중간 결과 중 하나를 최종 선택하세요."
    },
    {
      "level": 3,
      "title": "연결 방향",
      "body": "AND4.OUT/OR4.OUT을 M0의 A/B, XOR4.OUT/Adder4.SUM을 M1의 A/B에 연결하고 두 MUX의 SEL은 OP.B0로 연결하세요. M0/M1 출력은 M2의 A/B, M2.SEL은 OP.B1로 연결합니다. Adder4.CIN은 Const 0, M2.OUT은 OUT과 Zero4.IN으로 보냅니다."
    }
  ]
}
