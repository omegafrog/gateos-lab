{
  "schema": "gateos.challenge/v1",
  "id": "routing.decoder2to4",
  "title": "2-to-4 Address Decoder",
  "description": "2-bit binary ADDR를 Y0~Y3 중 정확히 하나만 1인 one-hot 신호로 바꾸는 Decoder를 만드세요. 주소 번호를 개별 enable 선으로 펼치는 write-selection 회로입니다.",
  "interface": {
    "inputs": [
      {
        "id": "addr",
        "name": "ADDR",
        "width": 2
      }
    ],
    "outputs": [
      {
        "id": "y0",
        "name": "Y0",
        "width": 1
      },
      {
        "id": "y1",
        "name": "Y1",
        "width": 1
      },
      {
        "id": "y2",
        "name": "Y2",
        "width": 1
      },
      {
        "id": "y3",
        "name": "Y3",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "builtin.split2",
    "user.not",
    "user.and"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "addr": 0
          },
          "out": {
            "y0": 1,
            "y1": 0,
            "y2": 0,
            "y3": 0
          }
        },
        {
          "in": {
            "addr": 1
          },
          "out": {
            "y0": 0,
            "y1": 1,
            "y2": 0,
            "y3": 0
          }
        },
        {
          "in": {
            "addr": 2
          },
          "out": {
            "y0": 0,
            "y1": 0,
            "y2": 1,
            "y3": 0
          }
        },
        {
          "in": {
            "addr": 3
          },
          "out": {
            "y0": 0,
            "y1": 0,
            "y2": 0,
            "y3": 1
          }
        }
      ]
    },
    {
      "type": "structural",
      "visibility": "visible",
      "rules": {
        "maxComponents": 7
      }
    }
  ],
  "unlocks": [
    "memory.ram4"
  ],
  "referenceTables": [
    {
      "id": "address-map",
      "title": "2-bit Address Decoder 선택표",
      "description": "Binary address를 one-hot enable로 펼친 표입니다. 정상적인 2-bit 입력에서는 항상 Y0~Y3 중 정확히 하나만 1이어야 합니다.",
      "columns": [
        {
          "id": "addr",
          "label": "ADDR",
          "group": "input"
        },
        {
          "id": "y0",
          "label": "Y0",
          "group": "output"
        },
        {
          "id": "y1",
          "label": "Y1",
          "group": "output"
        },
        {
          "id": "y2",
          "label": "Y2",
          "group": "output"
        },
        {
          "id": "y3",
          "label": "Y3",
          "group": "output"
        },
        {
          "id": "meaning",
          "label": "선택",
          "group": "note"
        }
      ],
      "rows": [
        {
          "addr": "00",
          "y0": "1",
          "y1": "0",
          "y2": "0",
          "y3": "0",
          "meaning": "word 0"
        },
        {
          "addr": "01",
          "y0": "0",
          "y1": "1",
          "y2": "0",
          "y3": "0",
          "meaning": "word 1"
        },
        {
          "addr": "10",
          "y0": "0",
          "y1": "0",
          "y2": "1",
          "y3": "0",
          "meaning": "word 2"
        },
        {
          "addr": "11",
          "y0": "0",
          "y1": "0",
          "y2": "0",
          "y3": "1",
          "meaning": "word 3"
        }
      ],
      "notes": [
        "Split2의 B0가 LSB, B1이 MSB입니다.",
        "Decoder는 memory에서 어느 word에 write할지 선택하는 데 사용됩니다."
      ]
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "각 출력은 주소 한 줄을 검출합니다",
      "body": "Y0은 00, Y1은 01, Y2는 10, Y3는 11일 때만 1이어야 합니다. 각 출력에 필요한 원래 bit/반전 bit 조합을 써보세요."
    },
    {
      "level": 2,
      "title": "주소 bit와 보수 bit를 준비하세요",
      "body": "Split2로 A0/A1을 얻고 각각 NOT한 값을 준비하면 네 minterm을 AND로 만들 수 있습니다."
    },
    {
      "level": 3,
      "title": "식으로 배선 검증",
      "body": "Y0=¬A1·¬A0, Y1=¬A1·A0, Y2=A1·¬A0, Y3=A1·A0가 되어야 합니다. B0가 LSB라는 점을 확인하세요."
    }
  ]
}
