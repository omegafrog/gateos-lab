  "referenceTables": [
    {
      "id": "memory-operation",
      "title": "RAM4 읽기 / 쓰기 동작",
      "description": "LOAD는 read enable이 아니라 write enable입니다. Q는 항상 현재 ADDR가 가리키는 word를 보여주고, memory state는 LOAD=1인 rising edge에서만 바뀝니다.",
      "timing": "Read는 combinational/asynchronous, write는 rising-edge synchronous로 모델링됩니다. ADDR만 바꿔서는 저장 내용이 변하지 않습니다.",
      "columns": [
        {
          "id": "load",
          "label": "LOAD",
          "group": "input"
        },
        {
          "id": "addr",
          "label": "ADDR",
          "group": "input"
        },
        {
          "id": "edge",
          "label": "CLK",
          "group": "input"
        },
        {
          "id": "action",
          "label": "동작",
          "group": "note"
        },
        {
          "id": "q",
          "label": "Q",
          "group": "output"
        }
      ],
      "rows": [
        {
          "load": "0",
          "addr": "aa",
          "edge": "—",
          "action": "Read only",
          "q": "RAM[aa]"
        },
        {
          "load": "1",
          "addr": "aa",
          "edge": "↑",
          "action": "RAM[aa] ← D",
          "q": "RAM[aa]"
        },
        {
          "load": "1",
          "addr": "aa",
          "edge": "↑ 없음",
          "action": "저장 안 함",
          "q": "RAM[aa]"
        }
      ],
      "notes": [
        "Decoder의 one-hot 출력으로 네 Register 중 하나의 LOAD만 활성화합니다.",
        "읽기 경로는 네 Register의 Q 중 ADDR가 고른 하나를 MUX tree로 선택합니다."
      ],
      "kind": "operation"
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "Read와 Write는 같은 주소를 다른 방식으로 씁니다",
      "body": "write는 ‘누가 state를 바꿀지’를 고르는 문제라 Decoder가 필요하고, read는 ‘누구의 Q를 볼지’를 고르는 문제라 MUX가 필요합니다."
    },
    {
      "level": 2,
      "title": "D/CLK는 공통, LOAD만 선택적으로",
      "body": "네 Register4 모두에 D와 CLK를 공유해도 됩니다. 하지만 각 LOAD는 global LOAD와 Decoder의 해당 one-hot 출력이 모두 1일 때만 활성화되어야 합니다."
    },
    {
      "level": 3,
      "title": "두 경로를 따로 추적하세요",
      "body": "ADDR→Decoder→각 Register.LOAD가 write path이고, 네 Register.Q→MUX tree→Q가 read path입니다. 두 path가 같은 ADDR 의미를 공유하는지 확인하세요."
    }
  ]
}
