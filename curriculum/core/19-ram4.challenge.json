{
  "schema": "gateos.challenge/v1",
  "id": "memory.ram4",
  "title": "RAM4 — 4 words × 4 bits",
  "description": "4개의 4-bit Register를 사용해 4-word RAM을 만드세요. ADDR가 읽을 word를 선택하고, LOAD=1인 rising edge에서는 선택된 word 하나에만 D를 저장해야 합니다. 읽기는 ADDR 변경에 따라 즉시 바뀝니다.",
  "interface": {
    "inputs": [
      {
        "id": "d",
        "name": "D",
        "width": 4
      },
      {
        "id": "addr",
        "name": "ADDR",
        "width": 2
      },
      {
        "id": "load",
        "name": "LOAD",
        "width": 1
      },
      {
        "id": "clk",
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 4
      }
    ]
  },
  "allowedComponents": [
    "builtin.split2",
    "user.decoder2to4",
    "user.and",
    "user.register4",
    "user.mux4"
  ],
  "validators": [
