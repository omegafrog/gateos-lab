{
  "schema": "gateos.challenge/v1",
  "id": "memory.ram4",
  "title": "RAM4 — 4 words × 4 bits",
  "description": "네 개의 4-bit Register를 주소로 선택할 수 있는 RAM4로 조직하세요. 같은 ADDR가 write에서는 Decoder를 통해 destination을 고르고, read에서는 MUX를 통해 source를 고른다는 구조가 핵심입니다.",
  "interface": {
    "inputs": [
      {
        "id": "d",
        "name": "D",
        "width": 4
      },
      {
        "id": "addr",
        "name": "ADDR",
        "width": 2
      },
      {
        "id": "load",
        "name": "LOAD",
        "width": 1
      },
      {
        "id": "clk",
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 4
      }
    ]
  },
  "allowedComponents": [
    "builtin.split2",
    "user.decoder2to4",
    "user.and",
    "user.register4",
    "user.mux4"
  ],
