            "addr": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "d": 10,
            "addr": 2
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "d": 12,
            "addr": 3
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "load": 0,
            "addr": 0
          }
        },
        {
