{
  "schema": "gateos.challenge/v1",
  "id": "routing.mux2",
  "title": "2-to-1 Multiplexer",
  "description": "SEL=0이면 A, SEL=1이면 B를 출력하는 2:1 MUX를 구현하세요. A/B는 data, SEL은 control이라는 구분과 control signal이 datapath의 경로를 선택한다는 개념이 핵심입니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 1
      },
      {
        "id": "b",
        "name": "B",
        "width": 1
      },
      {
        "id": "sel",
        "name": "SEL",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "out",
        "name": "OUT",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "user.not",
    "user.and",
    "user.or"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 1,
            "sel": 0
          },
          "out": {
            "out": 0
          }
        },
        {
          "in": {
            "a": 0,
            "b": 1,
            "sel": 1
          },
          "out": {
            "out": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 1,
            "b": 0,
            "sel": 0
          },
          "out": {
            "out": 1
          }
        },
        {
          "in": {
            "a": 1,
            "b": 0,
            "sel": 1
          },
          "out": {
            "out": 0
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1,
            "sel": 0
          },
          "out": {
            "out": 1
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1,
            "sel": 1
          },
          "out": {
            "out": 1
          }
        }
      ]
    }
  ],
  "unlocks": [
    "arithmetic.half-adder"
  ],
  "hints": [
    {
      "level": 1,
      "title": "SEL이 어떤 경로를 열지 결정",
      "body": "SEL=0일 때는 A 경로만 열리고, SEL=1일 때는 B 경로만 열리게 만들면 됩니다."
    },
    {
      "level": 2,
      "title": "두 선택 경로",
      "body": "A는 NOT SEL과 AND하고, B는 SEL과 AND한 뒤 두 결과를 OR로 합쳐보세요."
    },
    {
      "level": 3,
      "title": "연결 방향",
      "body": "A·SEL̅ 경로와 B·SEL 경로를 두 AND로 만들고, 두 AND 출력을 OR에 연결해 OUT을 만드세요."
    }
  ]
}
