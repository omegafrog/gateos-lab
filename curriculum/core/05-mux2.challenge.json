{
  "schema": "gateos.challenge/v1",
  "id": "routing.mux2",
  "title": "2-to-1 Multiplexer",
  "description": "A와 B 두 data input 중 SEL이 지정한 하나를 OUT으로 보내는 2:1 MUX를 만드세요. 이 과제의 핵심은 data와 control을 분리해 생각하는 것입니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 1
      },
      {
        "id": "b",
        "name": "B",
        "width": 1
      },
      {
        "id": "sel",
        "name": "SEL",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "out",
        "name": "OUT",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "user.not",
    "user.and",
    "user.or"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 1,
            "sel": 0
          },
          "out": {
            "out": 0
          }
        },
        {
          "in": {
            "a": 0,
            "b": 1,
            "sel": 1
          },
          "out": {
            "out": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 1,
            "b": 0,
            "sel": 0
          },
          "out": {
            "out": 1
          }
        },
        {
          "in": {
            "a": 1,
            "b": 0,
            "sel": 1
          },
          "out": {
            "out": 0
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1,
            "sel": 0
          },
          "out": {
            "out": 1
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1,
            "sel": 1
          },
          "out": {
            "out": 1
          }
        }
      ]
    }
  ],
  "unlocks": [
    "arithmetic.half-adder"
  ],
  "hints": [
    {
      "level": 1,
      "title": "SEL은 값이 아니라 경로를 고릅니다",
      "body": "SEL=0이면 A가, SEL=1이면 B가 OUT에 보여야 합니다. 두 data path 중 어느 쪽을 열지 생각하세요."
    },
    {
      "level": 2,
      "title": "두 경로를 서로 배타적으로 열기",
      "body": "A 경로는 ¬SEL과 AND하고, B 경로는 SEL과 AND하면 한 번에 한 경로만 활성화됩니다."
    },
    {
      "level": 3,
      "title": "배선 확인",
      "body": "¬SEL·A와 SEL·B를 만든 뒤 두 결과를 OR해 OUT으로 연결하세요. 이 구조는 y=¬s·a+s·b 식 그대로입니다."
    }
  ]
}
