{
  "schema": "gateos.challenge/v1",
  "id": "arithmetic.incrementer4",
  "title": "4-bit Incrementer",
  "description": "Adder4를 재사용해 IN+1을 계산하는 4-bit Incrementer를 만드세요. 이미 만든 general-purpose block에 상수를 넣어 더 구체적인 기능을 만드는 abstraction reuse가 핵심입니다.",
  "interface": {
    "inputs": [
      {
        "id": "in",
        "name": "IN",
        "width": 4
      }
    ],
    "outputs": [
      {
        "id": "out",
        "name": "OUT",
        "width": 4
      },
      {
        "id": "carry",
        "name": "CARRY",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "user.adder4",
    "builtin.const4.one",
    "builtin.const1.zero"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "in": 0
          },
          "out": {
            "out": 1,
            "carry": 0
          }
        },
        {
          "in": {
            "in": 1
          },
          "out": {
            "out": 2,
            "carry": 0
          }
        },
        {
          "in": {
            "in": 14
          },
          "out": {
            "out": 15,
            "carry": 0
          }
        },
        {
          "in": {
            "in": 15
          },
          "out": {
            "out": 0,
            "carry": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "in": 7
          },
          "out": {
            "out": 8,
            "carry": 0
          }
        },
        {
          "in": {
            "in": 9
          },
          "out": {
            "out": 10,
            "carry": 0
          }
        }
      ]
    },
    {
      "type": "structural",
      "visibility": "visible",
      "rules": {
        "maxComponents": 3
      }
    }
  ],
  "unlocks": [
    "state.register4"
  ],
  "hints": [
    {
      "level": 1,
      "title": "Increment는 특별한 산술이 아닙니다",
      "body": "IN+1은 이미 만든 Adder4에 적절한 두 번째 operand와 CIN을 넣으면 됩니다."
    },
    {
      "level": 2,
      "title": "상수 0001을 더하세요",
      "body": "Adder4의 A에 IN, B에 Const4 0001, CIN에 Const 0을 넣으면 정확히 +1이 됩니다."
    },
    {
      "level": 3,
      "title": "wrap-around도 정상 동작입니다",
      "body": "Adder4.SUM→OUT, Adder4.COUT→CARRY로 연결하세요. 1111+1은 OUT=0000, CARRY=1이 됩니다."
    }
  ]
}
