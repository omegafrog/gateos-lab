{
  "schema": "gateos.challenge/v1",
  "id": "memory.ram16",
  "title": "RAM16 — 16 words × 4 bits",
  "description": "RAM4 네 개를 bank로 묶어 16개의 4-bit word를 저장하는 RAM16을 구현하세요. 4-bit ADDR 전체는 0~15의 word 번호이며, 내부에서만 상위 2-bit로 bank를 고르고 하위 2-bit로 bank 내부 word를 고르는 계층적 addressing을 사용합니다.",
  "interface": {
    "inputs": [
      {
        "id": "d",
        "name": "D",
        "width": 4
      },
      {
        "id": "addr",
        "name": "ADDR",
        "width": 4
      },
      {
        "id": "load",
        "name": "LOAD",
        "width": 1
      },
      {
        "id": "clk",
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 4
      }
    ]
  },
  "allowedComponents": [
    "builtin.split4",
    "builtin.join2",
    "user.decoder2to4",
    "user.and",
    "user.ram4",
    "user.mux4"
  ],
