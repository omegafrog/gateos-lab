{
  "schema": "gateos.challenge/v1",
  "id": "memory.ram16",
  "title": "RAM16 — 16 words × 4 bits",
  "description": "RAM4 네 개를 bank로 묶어 16-word RAM을 만드세요. ADDR[3:2]는 bank를, ADDR[1:0]은 bank 내부 word를 고르며, read와 write가 같은 계층 주소 해석을 공유해야 합니다.",
  "interface": {
    "inputs": [
      {
        "id": "d",
        "name": "D",
        "width": 4
      },
      {
        "id": "addr",
        "name": "ADDR",
        "width": 4
      },
      {
        "id": "load",
        "name": "LOAD",
        "width": 1
      },
      {
        "id": "clk",
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 4
      }
    ]
  },
  "allowedComponents": [
    "builtin.split4",
    "builtin.join2",
    "user.decoder2to4",
    "user.and",
    "user.ram4",
    "user.mux4"
  ],
