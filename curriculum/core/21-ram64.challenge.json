  "referenceTables": [
    {
      "id": "address-hierarchy",
      "title": "RAM64 주소 계층",
      "description": "6-bit 주소를 상위 2-bit bank 번호와 하위 4-bit RAM16 내부 주소로 나눕니다.",
      "columns": [
        {
          "id": "addr",
          "label": "ADDR[5:0]",
          "group": "input"
        },
        {
          "id": "bank",
          "label": "ADDR[5:4]",
          "group": "state"
        },
        {
          "id": "word",
          "label": "ADDR[3:0]",
          "group": "state"
        },
        {
          "id": "meaning",
          "label": "선택 위치",
          "group": "note"
        }
      ],
      "rows": [
        {
          "addr": "00wwww",
          "bank": "00",
          "word": "wwww",
          "meaning": "RAM16 bank 0"
        },
        {
          "addr": "01wwww",
          "bank": "01",
          "word": "wwww",
          "meaning": "RAM16 bank 1"
        },
        {
          "addr": "10wwww",
          "bank": "10",
          "word": "wwww",
          "meaning": "RAM16 bank 2"
        },
        {
          "addr": "11wwww",
          "bank": "11",
          "word": "wwww",
          "meaning": "RAM16 bank 3"
        }
      ],
      "notes": [
        "Split6의 B0가 LSB, B5가 MSB입니다.",
        "B0~B3를 Join4로 묶어 모든 RAM16.ADDR에 공통으로 연결합니다.",
        "B4~B5는 Join2로 묶어 bank decoder에 넣습니다."
      ],
      "kind": "address"
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "RAM16 네 개를 한 단계 더 묶으세요",
      "body": "RAM64는 새로운 저장 원리가 아닙니다. RAM16 네 개를 bank로 보고 상위 주소 2-bit가 bank를 선택하게 하면 됩니다."
    },
    {
      "level": 2,
      "title": "주소를 low 4-bit와 high 2-bit로 분리",
      "body": "Split6로 ADDR를 풀고 B0~B3는 Join4로 RAM16 내부 주소를 만들고, B4~B5는 Join2로 bank 주소를 만드세요."
    },
    {
      "level": 3,
      "title": "구체적인 연결",
      "body": "HIGH→Decoder2to4, LOAD·Y0~Y3→각 RAM16.LOAD, LOW/D/CLK는 네 RAM16에 공통 연결하세요. 네 RAM16.Q는 B4/B5를 selector로 사용하는 MUX4 tree를 거쳐 최종 Q로 연결합니다."
    }
  ]
}
