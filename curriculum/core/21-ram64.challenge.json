        "name": "D",
        "width": 4
      },
      {
        "id": "addr",
        "name": "ADDR",
        "width": 6
      },
      {
        "id": "load",
        "name": "LOAD",
        "width": 1
      },
      {
        "id": "clk",
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 4
      }
    ]
  },
  "allowedComponents": [
    "builtin.split6",
    "builtin.join4",
    "builtin.join2",
    "user.decoder2to4",
    "user.and",
    "user.ram16",
    "user.mux4"
  ],
