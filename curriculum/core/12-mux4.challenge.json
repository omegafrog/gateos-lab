{
  "schema": "gateos.challenge/v1",
  "id": "routing.mux4",
  "title": "4-bit Multiplexer",
  "description": "두 4-bit word A와 B 중 하나를 SEL로 선택하는 4-bit MUX를 만드세요. 새 논리 함수를 배우기보다 bus를 bit-slice로 다루고, 하나의 control이 word 전체를 일관되게 선택하게 만드는 연습입니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 4
      },
      {
        "id": "b",
        "name": "B",
        "width": 4
      },
      {
        "id": "sel",
        "name": "SEL",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "out",
        "name": "OUT",
        "width": 4
      }
    ]
  },
  "allowedComponents": [
    "builtin.split4",
    "builtin.join4",
    "user.mux2"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 15,
            "sel": 0
          },
          "out": {
            "out": 0
          }
        },
        {
          "in": {
            "a": 0,
            "b": 15,
            "sel": 1
          },
          "out": {
            "out": 15
          }
        },
        {
          "in": {
            "a": 10,
            "b": 5,
            "sel": 0
          },
          "out": {
            "out": 10
          }
        },
        {
          "in": {
            "a": 10,
            "b": 5,
            "sel": 1
          },
          "out": {
            "out": 5
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 3,
            "b": 12,
            "sel": 0
          },
          "out": {
            "out": 3
          }
        },
        {
          "in": {
            "a": 3,
            "b": 12,
            "sel": 1
          },
          "out": {
            "out": 12
          }
        }
      ]
    },
    {
      "type": "structural",
      "visibility": "visible",
      "rules": {
        "maxComponents": 7
      }
    }
  ],
  "unlocks": [
    "arithmetic.adder4"
  ],
  "hints": [
    {
      "level": 1,
      "title": "word 전체가 같은 선택을 따라야 합니다",
      "body": "A0/B0부터 A3/B3까지 네 bit pair를 각각 1-bit MUX로 고르되 SEL은 네 MUX가 모두 공유해야 합니다."
    },
    {
      "level": 2,
      "title": "Split → parallel select → Join",
      "body": "A/B를 Split4로 나누고 같은 bit index끼리 MUX에 넣은 뒤, 네 출력을 같은 index로 Join4에 다시 묶으세요."
    },
    {
      "level": 3,
      "title": "bit significance를 확인하세요",
      "body": "B0는 LSB, B3는 MSB입니다. A.B0/B.B0→OUT.B0 … A.B3/B.B3→OUT.B3 순서를 보존하세요."
    }
  ]
}
