{
  "schema": "gateos.challenge/v1",
  "id": "logic.zero4",
  "title": "4-bit Zero Detector",
  "description": "4-bit IN이 정확히 0000일 때만 ZERO=1이 되는 Zero Detector를 만드세요. 여러 data bit를 하나의 control-friendly predicate로 줄이는 reduction logic을 처음 다룹니다.",
  "interface": {
    "inputs": [
      {
        "id": "in",
        "name": "IN",
        "width": 4
      }
    ],
    "outputs": [
      {
        "id": "zero",
        "name": "ZERO",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "builtin.split4",
    "user.or",
    "user.not"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "in": 0
          },
          "out": {
            "zero": 1
          }
        },
        {
          "in": {
            "in": 1
          },
          "out": {
            "zero": 0
          }
        },
        {
          "in": {
            "in": 8
          },
          "out": {
            "zero": 0
          }
        },
        {
          "in": {
            "in": 15
          },
          "out": {
            "zero": 0
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "in": 2
          },
          "out": {
            "zero": 0
          }
        },
        {
          "in": {
            "in": 10
          },
          "out": {
            "zero": 0
          }
        }
      ]
    },
    {
      "type": "structural",
      "visibility": "visible",
      "rules": {
        "maxComponents": 5
      }
    }
  ],
  "unlocks": [
    "arithmetic.alu4"
  ],
  "referenceTables": [
    {
      "id": "zero-flag",
      "title": "Zero flag 동작",
      "description": "Zero Detector는 4-bit 값을 1-bit predicate로 축약합니다. 0000 한 경우에서만 ZERO=1이고, 나머지 모든 값에서는 0입니다.",
      "columns": [
        {
          "id": "in",
          "label": "IN[3:0]",
          "group": "input"
        },
        {
          "id": "zero",
          "label": "ZERO",
          "group": "output"
        },
        {
          "id": "meaning",
          "label": "의미",
          "group": "note"
        }
      ],
      "rows": [
        {
          "in": "0000",
          "zero": "1",
          "meaning": "결과가 0"
        },
        {
          "in": "0001~1111",
          "zero": "0",
          "meaning": "결과가 0이 아님"
        }
      ]
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "ZERO보다 먼저 NONZERO를 생각하세요",
      "body": "네 bit 중 하나라도 1이면 값은 zero가 아닙니다. ‘하나라도 1’은 OR로 표현할 수 있습니다."
    },
    {
      "level": 2,
      "title": "OR-reduction 뒤에 NOT",
      "body": "B0/B1, B2/B3를 각각 OR하고 두 중간 결과를 다시 OR하면 4-bit 전체의 NONZERO 신호가 됩니다. 마지막에 반전하세요."
    },
    {
      "level": 3,
      "title": "축약 방향을 확인하세요",
      "body": "Split4→OR tree→NOT→ZERO 순서로 연결하세요. 이 회로의 출력은 4-bit가 아니라 조건 하나를 나타내는 1-bit입니다."
    }
  ]
}
