{
  "schema": "gateos.challenge/v1",
  "id": "state.program-counter4",
  "title": "4-bit Program Counter",
  "description": "현재 PC를 유지하거나 증가시키고, 외부 주소를 load하거나 reset할 수 있는 4-bit Program Counter를 만드세요. 핵심은 여러 next-address 후보와 control priority를 하나의 state transition으로 표현하는 것입니다.",
  "interface": {
    "inputs": [
      {
        "id": "d",
        "name": "D",
        "width": 4
      },
      {
        "id": "load",
        "name": "LOAD",
        "width": 1
      },
      {
        "id": "inc",
        "name": "INC",
        "width": 1
      },
      {
        "id": "reset",
        "name": "RESET",
        "width": 1
      },
      {
        "id": "clk",
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 4
      }
    ]
  },
  "allowedComponents": [
    "user.register4",
    "user.incrementer4",
    "user.mux4",
    "builtin.const4.zero",
    "builtin.const1.one"
  ],
  "validators": [
    {
      "type": "sequence",
      "visibility": "visible",
      "steps": [
        {
          "set": {
            "d": 0,
            "load": 0,
            "inc": 0,
            "reset": 1,
            "clk": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "reset": 0,
            "inc": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "inc": 0,
            "load": 1,
            "d": 9
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 9
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "load": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 9
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "inc": 1,
            "load": 1,
            "d": 4
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 4
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "reset": 1,
            "inc": 1,
            "load": 1,
            "d": 7
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        }
      ]
    },
    {
      "type": "sequence",
      "visibility": "hidden",
      "steps": [
        {
          "set": {
            "d": 0,
            "load": 0,
            "inc": 0,
            "reset": 1,
            "clk": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "reset": 0,
            "load": 1,
            "d": 15
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 15
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "load": 0,
            "inc": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 0
          }
        }
      ]
    },
    {
      "type": "structural",
      "visibility": "visible",
      "rules": {
        "maxComponents": 7
      }
    }
  ],
  "unlocks": [
    "routing.decoder2to4"
  ],
  "referenceTables": [
    {
      "id": "priority",
      "title": "Program Counter 상태 전이표",
      "description": "PC의 동작표는 여러 control이 동시에 1일 때 어떤 next address가 선택되는지까지 포함한 priority specification입니다.",
      "timing": "모든 control은 next PC를 combinational하게 선택하고, 실제 PC state는 rising edge에서만 갱신됩니다.",
      "columns": [
        {
          "id": "reset",
          "label": "RESET",
          "group": "input"
        },
        {
          "id": "load",
          "label": "LOAD",
          "group": "input"
        },
        {
          "id": "inc",
          "label": "INC",
          "group": "input"
        },
        {
          "id": "qnext",
          "label": "Q(edge 후)",
          "group": "output"
        },
        {
          "id": "meaning",
          "label": "의미",
          "group": "note"
        }
      ],
      "rows": [
        {
          "reset": "1",
          "load": "—",
          "inc": "—",
          "qnext": "0000",
          "meaning": "Reset"
        },
        {
          "reset": "0",
          "load": "1",
          "inc": "—",
          "qnext": "D",
          "meaning": "Load"
        },
        {
          "reset": "0",
          "load": "0",
          "inc": "1",
          "qnext": "Q + 1",
          "meaning": "Increment"
        },
        {
          "reset": "0",
          "load": "0",
          "inc": "0",
          "qnext": "Q",
          "meaning": "Hold"
        }
      ],
      "notes": [
        "RESET과 LOAD가 동시에 1이면 RESET이 우선합니다.",
        "LOAD와 INC가 동시에 1이면 LOAD가 우선합니다.",
        "1111에서 INC하면 0000으로 wrap됩니다."
      ]
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "먼저 우선순위를 문장으로 정하세요",
      "body": "RESET, LOAD, INC, HOLD가 동시에 요청될 수 있다고 가정하고 어떤 control이 무엇보다 우선해야 하는지 표의 contract대로 정리하세요."
    },
    {
      "level": 2,
      "title": "MUX nesting이 priority를 구현합니다",
      "body": "낮은 우선순위 후보를 먼저 선택하고, 더 높은 우선순위 control이 바깥쪽 MUX에서 그 결과를 덮어쓰게 하면 priority가 회로 구조에 직접 나타납니다."
    },
    {
      "level": 3,
      "title": "current와 next PC를 구분하세요",
      "body": "Register.Q는 current PC이고 Incrementer/MUX network는 next PC를 계산합니다. 최종 MUX 출력만 Register.D로 보내고 Q를 회로 Q로 내보내세요."
    }
  ]
}
