          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 4
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "reset": 1,
            "inc": 1,
            "load": 1,
            "d": 7
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "expect": {
            "q": 0
