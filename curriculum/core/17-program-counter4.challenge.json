{
  "schema": "gateos.challenge/v1",
  "id": "state.program-counter4",
  "title": "4-bit Program Counter",
  "description": "RESET, LOAD, INC를 지원하는 4-bit Program Counter를 만드세요. 우선순위는 RESET > LOAD > INC > HOLD이며 rising edge에서만 Q가 바뀝니다.",
  "interface": {
    "inputs": [
      {
        "id": "d",
        "name": "D",
        "width": 4
      },
      {
        "id": "load",
        "name": "LOAD",
        "width": 1
      },
      {
        "id": "inc",
        "name": "INC",
        "width": 1
      },
      {
        "id": "reset",
        "name": "RESET",
        "width": 1
      },
      {
        "id": "clk",
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 4
      }
    ]
  },
  "allowedComponents": [
    "user.register4",
    "user.incrementer4",
    "user.mux4",
    "builtin.const4.zero",
    "builtin.const1.one"
  ],
  "validators": [
    {
