            "q": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "inc": 0,
            "load": 1,
            "d": 9
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
