{
  "schema": "gateos.challenge/v1",
  "id": "logic.or4",
  "title": "4-bit Bitwise OR",
  "description": "4-bit A와 B의 각 bit에 OR를 독립적으로 적용하는 bitwise OR 회로를 만드세요.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 4
      },
      {
        "id": "b",
        "name": "B",
        "width": 4
      }
    ],
    "outputs": [
      {
        "id": "out",
        "name": "OUT",
        "width": 4
      }
    ]
  },
  "allowedComponents": [
    "builtin.split4",
    "builtin.join4",
    "user.or"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 15
          },
          "out": {
            "out": 15
          }
        },
        {
          "in": {
            "a": 10,
            "b": 12
          },
          "out": {
            "out": 14
          }
        },
        {
          "in": {
            "a": 5,
            "b": 3
          },
          "out": {
            "out": 7
          }
        },
        {
          "in": {
            "a": 8,
            "b": 1
          },
          "out": {
            "out": 9
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 9,
            "b": 6
          },
          "out": {
            "out": 15
          }
        },
        {
          "in": {
            "a": 2,
            "b": 4
          },
          "out": {
            "out": 6
          }
        }
      ]
    },
    {
      "type": "structural",
      "visibility": "visible",
      "rules": {
        "maxComponents": 7
      }
    }
  ],
  "unlocks": [
    "logic.xor4"
  ],
  "hints": [
    {
      "level": 1,
      "title": "AND4와 같은 확장 방식",
      "body": "이번에도 4-bit bus를 네 개의 1-bit 선으로 보고 각 bit에 OR를 적용하면 됩니다."
    },
    {
      "level": 2,
      "title": "같은 bit 번호끼리 OR",
      "body": "A/B를 Split4로 풀어 A0 OR B0, A1 OR B1, A2 OR B2, A3 OR B3를 각각 계산하세요."
    },
    {
      "level": 3,
      "title": "연결 방향",
      "body": "네 OR 출력을 Join4의 B0~B3에 같은 순서로 연결하고 Join4.OUT을 회로 OUT에 연결하세요."
    }
  ]
}
