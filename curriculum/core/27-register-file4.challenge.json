{
  "schema": "gateos.challenge/v1",
  "id": "memory.register-file4",
  "title": "4×4-bit Register File",
  "description": "네 개의 4-bit Register를 공유 state로 묶고, 두 개의 독립 read port와 하나의 write port를 가진 Register File을 만드세요. CPU가 두 source operand를 동시에 읽고 한 destination에 쓰는 구조를 직접 구현합니다.",
  "interface": {
    "inputs": [
      {
        "id": "d",
        "name": "D",
        "width": 4
      },
      {
        "id": "waddr",
        "name": "WADDR",
        "width": 2
      },
      {
        "id": "we",
        "name": "WE",
        "width": 1
      },
      {
        "id": "raddr_a",
        "name": "RADDR_A",
        "width": 2
      },
      {
        "id": "raddr_b",
        "name": "RADDR_B",
        "width": 2
      },
      {
        "id": "clk",
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "qa",
        "name": "QA",
        "width": 4
      },
      {
        "id": "qb",
        "name": "QB",
        "width": 4
      }
    ]
  },
  "allowedComponents": [
    "builtin.split2",
    "user.decoder2to4",
    "user.and",
    "user.register4",
    "user.mux4"
  ],
  "validators": [
    {
      "type": "sequence",
      "visibility": "visible",
      "steps": [
        {
          "set": {
            "d": 3,
            "waddr": 0,
            "we": 1,
            "raddr_a": 0,
            "raddr_b": 0,
            "clk": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "d": 5,
            "waddr": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "d": 10,
            "waddr": 2
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "d": 12,
            "waddr": 3
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "we": 0,
            "raddr_a": 0,
            "raddr_b": 3
          }
        },
        {
          "expect": {
            "qa": 3,
            "qb": 12
          }
        },
        {
          "set": {
            "raddr_a": 2,
            "raddr_b": 1
          }
        },
        {
          "expect": {
            "qa": 10,
            "qb": 5
          }
        }
      ]
    },
    {
      "type": "sequence",
      "visibility": "hidden",
      "steps": [
        {
          "set": {
            "d": 7,
            "waddr": 1,
            "we": 1,
            "raddr_a": 0,
            "raddr_b": 0,
            "clk": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "d": 14,
            "waddr": 3
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "d": 2,
            "waddr": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "we": 0,
            "raddr_a": 1,
            "raddr_b": 3
          }
        },
        {
          "expect": {
            "qa": 2,
            "qb": 14
          }
        }
      ]
    },
    {
      "type": "structural",
      "visibility": "visible",
      "rules": {
        "maxComponents": 17
      }
    }
  ],
  "unlocks": [
    "cpu.register-transfer4"
  ],
  "referenceTables": [
    {
      "id": "ports",
      "title": "Register File read / write 동작",
      "description": "두 read port는 combinational하게 동시에 동작하고, 한 write port는 rising edge에서만 state를 바꿉니다. 같은 register array를 읽기/쓰기 port들이 공유합니다.",
      "timing": "Read: RADDR_A/B 변화 후 QA/QB가 선택된 register 값을 보여줍니다. Write: WE=1인 rising edge에서만 R[WADDR]←D가 일어납니다.",
      "columns": [
        {
          "id": "we",
          "label": "WE",
          "group": "input"
        },
        {
          "id": "waddr",
          "label": "WADDR",
          "group": "input"
        },
        {
          "id": "raddr",
          "label": "RADDR_A / B",
          "group": "input"
        },
        {
          "id": "write",
          "label": "Write",
          "group": "note"
        },
        {
          "id": "read",
          "label": "Read",
          "group": "output"
        }
      ],
      "rows": [
        {
          "we": "0",
          "waddr": "—",
          "raddr": "aa / bb",
          "write": "저장 없음",
          "read": "QA=R[aa], QB=R[bb]"
        },
        {
          "we": "1",
          "waddr": "ww",
          "raddr": "aa / bb",
          "write": "R[ww] ← D (↑)",
          "read": "QA=R[aa], QB=R[bb]"
        }
      ],
      "notes": [
        "WADDR decoder는 네 Register 중 하나의 LOAD만 활성화합니다.",
        "RADDR_A와 RADDR_B는 각각 독립적인 MUX tree를 사용하므로 동시에 두 Register를 읽을 수 있습니다."
      ]
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "세 port는 같은 register array를 다른 방식으로 봅니다",
      "body": "RADDR_A와 RADDR_B는 각각 QA/QB source를 고르고, WADDR는 WE=1인 edge에서 갱신할 destination을 고릅니다."
    },
    {
      "level": 2,
      "title": "write는 Decoder 하나, read는 MUX network 두 개",
      "body": "WADDR를 one-hot으로 decode해 각 Register.LOAD와 WE를 결합하세요. QA와 QB는 서로 독립된 MUX tree가 필요합니다."
    },
    {
      "level": 3,
      "title": "timing을 따로 검증하세요",
      "body": "read address를 바꾸면 clock 없이 QA/QB가 바뀌어야 합니다. write는 D/WADDR/WE가 준비된 뒤 rising edge가 와야만 state가 변경되어야 합니다."
    }
  ]
}
