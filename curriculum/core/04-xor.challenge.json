{
  "schema": "gateos.challenge/v1",
  "id": "logic.xor",
  "title": "XOR",
  "description": "NOT, AND, OR을 사용해 XOR을 만드세요. XOR은 ‘두 입력이 서로 다를 때만 1’이며, 뒤에서 binary addition의 SUM bit가 되는 중요한 함수입니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 1
      },
      {
        "id": "b",
        "name": "B",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "out",
        "name": "OUT",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "user.not",
    "user.and",
    "user.or"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 0
          },
          "out": {
            "out": 0
          }
        },
        {
          "in": {
            "a": 0,
            "b": 1
          },
          "out": {
            "out": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 1,
            "b": 0
          },
          "out": {
            "out": 1
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1
          },
          "out": {
            "out": 0
          }
        }
      ]
    }
  ],
  "unlocks": [
    "routing.mux2"
  ],
  "hints": [
    {
      "level": 1,
      "title": "1이 되는 두 경우를 분리하세요",
      "body": "XOR은 01과 10에서만 1입니다. 이 두 input pattern을 각각 검출하는 식을 먼저 생각하세요."
    },
    {
      "level": 2,
      "title": "두 minterm을 OR로 합치기",
      "body": "A·¬B와 ¬A·B를 각각 만들고 두 결과를 OR하면 XOR이 됩니다."
    },
    {
      "level": 3,
      "title": "배선 확인",
      "body": "A/B의 반전 신호를 준비한 뒤 AND 두 개로 A·¬B, ¬A·B를 만들고, 두 AND 출력을 OR해 OUT으로 보내세요."
    }
  ]
}
