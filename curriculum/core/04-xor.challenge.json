{
  "schema": "gateos.challenge/v1",
  "id": "logic.xor",
  "title": "XOR",
  "description": "NOT, AND, OR을 사용해 XOR을 만드세요. XOR은 ‘두 입력이 서로 다를 때만 1’이며, 뒤에서 binary addition의 SUM bit가 되는 중요한 함수입니다.",
  "interface": {
    "inputs": [
      {
        "id": "a",
        "name": "A",
        "width": 1
      },
      {
        "id": "b",
        "name": "B",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "out",
        "name": "OUT",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "user.not",
    "user.and",
    "user.or"
  ],
  "validators": [
    {
      "type": "truthTable",
      "visibility": "visible",
      "cases": [
        {
          "in": {
            "a": 0,
            "b": 0
          },
          "out": {
            "out": 0
          }
        },
        {
          "in": {
            "a": 0,
            "b": 1
          },
          "out": {
            "out": 1
          }
        }
      ]
    },
    {
      "type": "truthTable",
      "visibility": "hidden",
      "cases": [
        {
          "in": {
            "a": 1,
            "b": 0
          },
          "out": {
            "out": 1
          }
        },
        {
          "in": {
            "a": 1,
            "b": 1
          },
          "out": {
            "out": 0
          }
        }
      ]
    }
  ],
  "unlocks": [
    "routing.mux2"
  ],
  "hints": [
    {
      "level": 1,
      "title": "1이 되는 두 경우를 분리하세요",
      "body": "XOR은 01과 10에서만 1입니다. 두 입력이 서로 다른 두 경우를 각각 별도의 조건식으로 검출한다고 생각해보세요."
    },
    {
      "level": 2,
      "title": "두 minterm을 OR로 합치기",
      "body": "A·¬B는 10을, ¬A·B는 01을 검출합니다. 서로 겹치지 않는 이 두 minterm의 출력을 OR하면 XOR의 전체 truth table을 만족합니다."
    },
    {
      "level": 3,
      "title": "배선 구조를 식과 대조하세요",
      "body": "A와 B의 반전 신호를 준비하고 AND 두 개로 A·¬B와 ¬A·B를 만든 뒤, 두 AND 출력을 마지막 OR에 연결해 OUT으로 보내세요."
    }
  ]
}
