{
  "schema": "gateos.challenge/v1",
  "id": "state.sr-latch",
  "title": "SR Latch",
  "description": "두 NAND의 출력을 서로 되먹임해 1 bit의 상태를 기억하는 active-low SR Latch를 만드세요. S̅=0은 Set, R̅=0은 Reset, 둘 다 1이면 이전 상태를 유지합니다.",
  "interface": {
    "inputs": [
      {
        "id": "sbar",
        "name": "S̅",
        "width": 1
      },
      {
        "id": "rbar",
        "name": "R̅",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 1
      },
      {
        "id": "nq",
        "name": "Q̅",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "builtin.nand"
  ],
  "validators": [
    {
      "type": "sequence",
      "visibility": "visible",
      "steps": [
        {
          "set": {
            "sbar": 0,
            "rbar": 1
          }
        },
        {
          "expect": {
            "q": 1,
            "nq": 0
          }
        },
        {
          "set": {
            "sbar": 1,
            "rbar": 1
          }
        },
        {
          "expect": {
            "q": 1,
            "nq": 0
          }
        },
        {
          "set": {
            "sbar": 1,
            "rbar": 0
          }
        },
        {
          "expect": {
            "q": 0,
            "nq": 1
          }
        },
        {
          "set": {
            "sbar": 1,
            "rbar": 1
          }
        },
        {
          "expect": {
            "q": 0,
            "nq": 1
          }
        }
      ]
    },
    {
      "type": "structural",
      "rules": {
        "allowed": [
          "builtin.nand"
        ],
        "maxComponents": 4
      }
    }
  ],
  "unlocks": [
    "state.d-latch"
  ],
  "referenceTables": [
    {
      "id": "characteristic",
      "title": "SR Latch state table",
      "description": "This latch stores state through cross-coupled NAND feedback. There is no clock.",
      "columns": [
        {
          "id": "sbar",
          "label": "S̅",
          "group": "input"
        },
        {
          "id": "rbar",
          "label": "R̅",
          "group": "input"
        },
        {
          "id": "qt",
          "label": "Q(before)",
          "group": "state"
        },
        {
          "id": "nqt",
          "label": "Q̅(before)",
          "group": "state"
        },
        {
          "id": "qnext",
          "label": "Q(after settle)",
          "group": "output"
        },
        {
          "id": "nqnext",
          "label": "Q̅(after settle)",
          "group": "output"
        },
        {
          "id": "meaning",
          "label": "Meaning",
          "group": "note"
        }
      ],
      "rows": [
        {
          "sbar": "0",
          "rbar": "1",
          "qt": "X",
          "nqt": "X",
          "qnext": "1",
          "nqnext": "0",
          "meaning": "Set"
        },
        {
          "sbar": "1",
          "rbar": "0",
          "qt": "X",
          "nqt": "X",
          "qnext": "0",
          "nqnext": "1",
          "meaning": "Reset"
        },
        {
          "sbar": "1",
          "rbar": "1",
          "qt": "0",
          "nqt": "1",
          "qnext": "0",
          "nqnext": "1",
          "meaning": "Hold"
        },
        {
          "sbar": "1",
          "rbar": "1",
          "qt": "1",
          "nqt": "0",
          "qnext": "1",
          "nqnext": "0",
          "meaning": "Hold"
        },
        {
          "sbar": "0",
          "rbar": "0",
          "qt": "X",
          "nqt": "X",
          "qnext": "1",
          "nqnext": "1",
          "meaning": "Forbidden"
        }
      ],
      "notes": [
        "S̅/R̅ are active-low inputs.",
        "With S̅=R̅=1, neither side forces a new value, so feedback preserves the previous Q/Q̅ state.",
        "S̅=0,R̅=0 forces Q=Q̅=1 and is forbidden."
      ],
      "timing": "Asynchronous — no clock. Inputs take effect after the feedback loop settles."
    }
  ]
}
