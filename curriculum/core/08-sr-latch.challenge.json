{
  "schema": "gateos.challenge/v1",
  "id": "state.sr-latch",
  "title": "SR Latch",
  "description": "두 NAND의 출력을 서로 되먹임해 1 bit의 상태를 기억하는 active-low SR Latch를 만드세요. S̅=0은 Set, R̅=0은 Reset, 둘 다 1이면 이전 상태를 유지합니다.",
  "interface": {
    "inputs": [
      {
        "id": "sbar",
        "name": "S̅",
        "width": 1
      },
      {
        "id": "rbar",
        "name": "R̅",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "q",
        "name": "Q",
        "width": 1
      },
      {
        "id": "nq",
        "name": "Q̅",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "builtin.nand"
  ],
  "validators": [
    {
      "type": "sequence",
      "visibility": "visible",
      "steps": [
        {
          "set": {
            "sbar": 0,
            "rbar": 1
          }
        },
        {
          "expect": {
            "q": 1,
            "nq": 0
          }
        },
        {
          "set": {
            "sbar": 1,
            "rbar": 1
          }
        },
        {
          "expect": {
            "q": 1,
            "nq": 0
          }
        },
        {
          "set": {
            "sbar": 1,
            "rbar": 0
          }
        },
        {
          "expect": {
            "q": 0,
            "nq": 1
          }
        },
        {
          "set": {
            "sbar": 1,
            "rbar": 1
          }
        },
        {
          "expect": {
            "q": 0,
            "nq": 1
          }
        }
      ]
    },
    {
      "type": "structural",
      "rules": {
        "allowed": [
          "builtin.nand"
        ],
        "maxComponents": 4
      }
    }
  ],
  "unlocks": [
    "state.d-latch"
  ],
  "referenceTables": [
    {
      "id": "characteristic",
      "title": "SR Latch 상태표",
      "description": "교차 결합(cross-coupled)된 두 NAND의 feedback으로 상태를 저장합니다. Clock은 사용하지 않습니다.",
      "columns": [
        {
          "id": "sbar",
          "label": "S̅",
          "group": "input"
        },
        {
          "id": "rbar",
          "label": "R̅",
          "group": "input"
        },
        {
          "id": "qt",
          "label": "Q(적용 전)",
          "group": "state"
        },
        {
          "id": "nqt",
          "label": "Q̅(적용 전)",
          "group": "state"
        },
        {
          "id": "qnext",
          "label": "Q(settle 후)",
          "group": "output"
        },
        {
          "id": "nqnext",
          "label": "Q̅(settle 후)",
          "group": "output"
        },
        {
          "id": "meaning",
          "label": "의미",
          "group": "note"
        }
      ],
      "rows": [
        {
          "sbar": "0",
          "rbar": "1",
          "qt": "X",
          "nqt": "X",
          "qnext": "1",
          "nqnext": "0",
          "meaning": "Set (설정)"
        },
        {
          "sbar": "1",
          "rbar": "0",
          "qt": "X",
          "nqt": "X",
          "qnext": "0",
          "nqnext": "1",
          "meaning": "Reset (초기화)"
        },
        {
          "sbar": "1",
          "rbar": "1",
          "qt": "0",
          "nqt": "1",
          "qnext": "0",
          "nqnext": "1",
          "meaning": "Hold (유지)"
        },
        {
          "sbar": "1",
          "rbar": "1",
          "qt": "1",
          "nqt": "0",
          "qnext": "1",
          "nqnext": "0",
          "meaning": "Hold (유지)"
        },
        {
          "sbar": "0",
          "rbar": "0",
          "qt": "X",
          "nqt": "X",
          "qnext": "1",
          "nqnext": "1",
          "meaning": "Forbidden (금지)"
        }
      ],
      "notes": [
        "S̅와 R̅는 active-low 입력입니다.",
        "S̅=R̅=1이면 새로운 값을 강제하지 않으므로 feedback이 기존 Q/Q̅ 상태를 유지합니다.",
        "S̅=R̅=0이면 Q=Q̅=1이 되어 서로 보수 관계가 깨지므로 금지 상태입니다."
      ],
      "timing": "비동기(asynchronous) — Clock 없음. S̅/R̅ 입력을 적용한 뒤 feedback이 안정(settle)되면 출력이 결정됩니다."
    }
  ],
  "initialInputs": {
    "sbar": 1,
    "rbar": 1
  },
  "hints": [
    {
      "level": 1,
      "title": "저장은 feedback에서 생깁니다",
      "body": "SR Latch에는 Clock이 없습니다. 두 NAND의 출력이 서로의 입력으로 되먹임(feedback)되기 때문에 이전 상태가 유지됩니다."
    },
    {
      "level": 2,
      "title": "두 NAND를 교차 결합",
      "body": "한 NAND가 Q를 만들고 다른 NAND가 Q̅를 만들도록 한 뒤, Q를 반대쪽 NAND 입력으로, Q̅도 반대쪽 NAND 입력으로 연결하세요."
    },
    {
      "level": 3,
      "title": "active-low 연결",
      "body": "Q를 만드는 NAND에는 S̅와 Q̅를 넣고, Q̅를 만드는 NAND에는 R̅와 Q를 넣으세요. 두 NAND 출력은 각각 Q, Q̅에도 연결합니다."
    }
  ]
}
