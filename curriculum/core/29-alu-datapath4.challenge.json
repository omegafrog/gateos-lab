{
  "schema": "gateos.challenge/v1",
  "id": "cpu.alu-datapath4",
  "title": "Register → ALU → Register Datapath",
  "description": "Register File에서 두 operand를 읽고 ALU가 계산한 뒤 결과를 다시 destination register에 write-back하는 4-bit CPU datapath를 구현하세요. 한 cycle을 state read → combinational execute/select → state write로 바라보고 datapath와 control의 역할을 분리하는 것이 최종 목표입니다.",
  "interface": {
    "inputs": [
      {
        "id": "data",
        "name": "DATA",
        "width": 4
      },
      {
        "id": "waddr",
        "name": "WADDR",
        "width": 2
      },
      {
        "id": "ra",
        "name": "RA",
        "width": 2
      },
      {
        "id": "rb",
        "name": "RB",
        "width": 2
      },
      {
        "id": "op",
        "name": "OP",
        "width": 2
      },
      {
        "id": "load",
        "name": "LOAD",
        "width": 1
      },
      {
        "id": "exec",
        "name": "EXEC",
        "width": 1
      },
      {
        "id": "clk",
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "a",
        "name": "A",
        "width": 4
      },
      {
        "id": "b",
        "name": "B",
        "width": 4
      },
      {
        "id": "result",
        "name": "RESULT",
        "width": 4
      },
      {
        "id": "zero",
        "name": "ZERO",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "user.register-file4",
    "user.alu4",
    "user.mux4",
    "user.or"
  ],
  "validators": [
    {
      "type": "sequence",
      "visibility": "visible",
      "steps": [
        {
          "set": {
            "data": 3,
            "waddr": 0,
            "ra": 0,
            "rb": 0,
            "op": 3,
            "load": 1,
            "exec": 0,
            "clk": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "data": 5,
            "waddr": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "load": 0,
            "ra": 0,
            "rb": 1,
            "waddr": 2,
            "op": 3
          }
        },
        {
          "expect": {
            "a": 3,
            "b": 5,
            "result": 8,
            "zero": 0
          }
        },
        {
          "set": {
            "exec": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0,
            "exec": 0
          }
        },
        {
          "set": {
            "ra": 2,
            "rb": 2,
            "op": 2
          }
        },
        {
          "expect": {
            "a": 8,
            "b": 8,
            "result": 0,
            "zero": 1
          }
        }
      ]
    },
    {
      "type": "sequence",
      "visibility": "hidden",
      "steps": [
        {
          "set": {
            "data": 10,
            "waddr": 0,
            "ra": 0,
            "rb": 0,
            "op": 0,
            "load": 1,
            "exec": 0,
            "clk": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "data": 12,
            "waddr": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "load": 0,
            "ra": 0,
            "rb": 1,
            "waddr": 3,
            "op": 0
          }
        },
        {
          "expect": {
            "result": 8,
            "zero": 0
