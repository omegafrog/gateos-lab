{
  "schema": "gateos.challenge/v1",
  "id": "cpu.alu-datapath4",
  "title": "Register → ALU → Register Datapath",
  "description": "Register File의 두 source를 ALU에 넣고 결과를 다시 destination register로 write-back하는 CPU형 datapath를 만드세요. 한 cycle을 state read → combinational execute/select → rising-edge commit으로 추적할 수 있어야 합니다.",
  "interface": {
    "inputs": [
      {
        "id": "data",
        "name": "DATA",
        "width": 4
      },
      {
        "id": "waddr",
        "name": "WADDR",
        "width": 2
      },
      {
        "id": "ra",
        "name": "RA",
        "width": 2
      },
      {
        "id": "rb",
        "name": "RB",
        "width": 2
      },
      {
        "id": "op",
        "name": "OP",
        "width": 2
      },
      {
        "id": "load",
        "name": "LOAD",
        "width": 1
      },
      {
        "id": "exec",
        "name": "EXEC",
        "width": 1
      },
      {
        "id": "clk",
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "id": "a",
        "name": "A",
        "width": 4
      },
      {
        "id": "b",
        "name": "B",
        "width": 4
      },
      {
        "id": "result",
        "name": "RESULT",
        "width": 4
      },
      {
        "id": "zero",
        "name": "ZERO",
        "width": 1
      }
    ]
  },
  "allowedComponents": [
    "user.register-file4",
    "user.alu4",
    "user.mux4",
    "user.or"
  ],
  "validators": [
    {
      "type": "sequence",
      "visibility": "visible",
      "steps": [
        {
          "set": {
            "data": 3,
            "waddr": 0,
            "ra": 0,
            "rb": 0,
            "op": 3,
            "load": 1,
            "exec": 0,
            "clk": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "data": 5,
            "waddr": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "load": 0,
            "ra": 0,
            "rb": 1,
            "waddr": 2,
            "op": 3
          }
        },
        {
          "expect": {
            "a": 3,
            "b": 5,
            "result": 8,
            "zero": 0
          }
        },
        {
          "set": {
            "exec": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0,
            "exec": 0
          }
        },
        {
          "set": {
            "ra": 2,
            "rb": 2,
            "op": 2
          }
        },
        {
          "expect": {
            "a": 8,
            "b": 8,
            "result": 0,
            "zero": 1
          }
        }
      ]
    },
    {
      "type": "sequence",
      "visibility": "hidden",
      "steps": [
        {
          "set": {
            "data": 10,
            "waddr": 0,
            "ra": 0,
            "rb": 0,
            "op": 0,
            "load": 1,
            "exec": 0,
            "clk": 0
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "data": 12,
            "waddr": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0
          }
        },
        {
          "set": {
            "load": 0,
            "ra": 0,
            "rb": 1,
            "waddr": 3,
            "op": 0
          }
        },
        {
          "expect": {
            "result": 8,
            "zero": 0
          }
        },
        {
          "set": {
            "exec": 1
          }
        },
        {
          "set": {
            "clk": 1
          }
        },
        {
          "set": {
            "clk": 0,
            "exec": 0
          }
        },
        {
          "set": {
            "ra": 3,
            "rb": 3,
            "op": 2
          }
        },
        {
          "expect": {
            "a": 8,
            "b": 8,
            "result": 0,
            "zero": 1
          }
        }
      ]
    },
    {
      "type": "structural",
      "visibility": "visible",
      "rules": {
        "maxComponents": 4
      }
    }
  ],
  "unlocks": [],
  "referenceTables": [
    {
      "id": "datapath-control",
      "title": "Datapath write-back 제어",
      "description": "이 표는 gate truth table이 아니라 datapath control contract입니다. control 조합마다 어떤 write source가 선택되고 register state가 갱신되는지 추적하세요.",
      "timing": "RA/RB/OP 변화는 cycle 안에서 combinational하게 전파됩니다. Register File write는 write-back data와 control이 안정된 뒤 rising edge에서 commit됩니다.",
      "columns": [
        {
          "id": "load",
          "label": "LOAD",
          "group": "input"
        },
        {
          "id": "exec",
          "label": "EXEC",
          "group": "input"
        },
        {
          "id": "writeData",
          "label": "RF.D",
          "group": "state"
        },
        {
          "id": "we",
          "label": "RF.WE",
          "group": "output"
        },
        {
          "id": "meaning",
          "label": "동작",
          "group": "note"
        }
      ],
      "rows": [
        {
          "load": "0",
          "exec": "0",
          "writeData": "—",
          "we": "0",
          "meaning": "Register 유지"
        },
        {
          "load": "1",
          "exec": "0",
          "writeData": "DATA",
          "we": "1",
          "meaning": "외부 값 load"
        },
        {
          "load": "—",
          "exec": "1",
          "writeData": "ALU.OUT",
          "we": "1",
          "meaning": "ALU 결과 write-back"
        }
      ],
      "notes": [
        "EXEC=1이면 ALU 결과를 선택하도록 구성하면 EXEC가 LOAD보다 높은 우선순위를 갖습니다."
      ]
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "한 cycle을 세 구간으로 나누세요",
      "body": "먼저 RA/RB가 current register state를 읽고, 그다음 ALU와 write-back MUX가 결과를 계산하며, 마지막 rising edge에서만 destination state가 바뀝니다."
    },
    {
      "level": 2,
      "title": "datapath와 control을 분리하세요",
      "body": "Register File→ALU→write-back은 가능한 data path입니다. OP, LOAD, EXEC는 그 경로에서 어떤 연산/소스/write를 활성화할지 정하는 control입니다."
    },
    {
      "level": 3,
      "title": "write-back loop를 닫으세요",
      "body": "QA/QB→ALU.A/B, ALU.OUT→RESULT와 write-back MUX 후보, MUX.OUT→RegisterFile.D로 연결하세요. WADDR와 write enable을 준비한 뒤 clock edge가 실제 state transition을 만듭니다."
    }
  ]
}
