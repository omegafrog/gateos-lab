        "maxComponents": 4
      }
    }
  ],
  "unlocks": [],
  "referenceTables": [
    {
      "id": "datapath-control",
      "title": "Datapath write-back 제어",
      "description": "Register File의 두 출력은 항상 ALU 입력으로 연결되고, write-back source만 LOAD/EXEC에 따라 달라집니다.",
      "timing": "LOAD 또는 EXEC가 1인 rising edge에서 WADDR Register가 갱신됩니다.",
      "columns": [
        {
          "id": "load",
          "label": "LOAD",
          "group": "input"
        },
        {
          "id": "exec",
          "label": "EXEC",
          "group": "input"
        },
        {
          "id": "writeData",
          "label": "RF.D",
          "group": "state"
        },
        {
          "id": "we",
          "label": "RF.WE",
          "group": "output"
        },
        {
          "id": "meaning",
          "label": "동작",
          "group": "note"
        }
      ],
      "rows": [
        {
          "load": "0",
          "exec": "0",
          "writeData": "—",
          "we": "0",
          "meaning": "Register 유지"
        },
        {
          "load": "1",
          "exec": "0",
          "writeData": "DATA",
          "we": "1",
          "meaning": "외부 값 load"
        },
        {
          "load": "—",
          "exec": "1",
          "writeData": "ALU.OUT",
          "we": "1",
          "meaning": "ALU 결과 write-back"
        }
      ],
      "notes": [
        "EXEC=1이면 ALU 결과를 선택하도록 구성하면 EXEC가 LOAD보다 높은 우선순위를 갖습니다."
      ]
    }
  ],
  "hints": [
    {
      "level": 1,
      "title": "CPU datapath의 핵심 고리",
      "body": "Register File에서 두 값을 읽고 ALU가 계산한 결과를 다시 Register File에 쓰는 순환 경로가 CPU datapath의 중심입니다."
    },
    {
      "level": 2,
      "title": "read → execute → write-back",
      "body": "RF.QA/QB를 ALU.A/B로 연결하고 ALU.OUT을 write-back MUX에 넣으세요. 외부 DATA는 load용 다른 입력입니다."
    },
    {
      "level": 3,
      "title": "구체적인 연결",
      "body": "RF.RADDR_A=RA, RADDR_B=RB, WADDR=WADDR, QA/QB→ALU.A/B, OP→ALU.OP. MUX(A=DATA,B=ALU.OUT,SEL=EXEC)→RF.D, OR(LOAD,EXEC)→RF.WE, ALU.OUT/ZERO와 RF.QA/QB를 출력에 연결하세요."
    }
  ]
}
